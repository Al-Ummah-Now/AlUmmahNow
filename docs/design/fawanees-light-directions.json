{
  "$description": "Fawanees light-mode directions for owner review (design only, not applied). color = tokens.color.light overrides; components = light component colour overrides; materials = light-only CSS custom properties used in the renders.",
  "basedOn": "fawanees@1.1.0",
  "directions": {
    "a": {
      "name": "Lamplit Ivory",
      "nameAr": "عاج مضاء",
      "summary": "Warm ivory parchment page, white cards, ink text. Gold appears only where you act (primary buttons, the lantern indicator, progress) and as one soft lamp-glow in the hero.",
      "color": {
        "background": "#f7f2e7",
        "surface": "#fffdf8",
        "surfaceRaised": "#ffffff",
        "heroStart": "#f3e4c0",
        "heroEnd": "#f7f2e7",
        "textPrimary": "#0b2534",
        "textSecondary": "#2b4452",
        "textMuted": "#475c67",
        "link": "#7a4300",
        "accent": "#9a5200",
        "motif": "#b07a2a",
        "primary": "#f4ae3a",
        "onPrimary": "#09151e",
        "primaryHover": "#fbc661",
        "primaryPressed": "#e0962a",
        "primaryDisabled": "#ece3cf",
        "onPrimaryDisabled": "#475c67",
        "primaryEdge": "#8a5a12",
        "primarySheen": "#ffe6a8",
        "focusRing": "#8a5a12",
        "focusGlow": "#a85600",
        "outline": "#7d6d55",
        "divider": "#e6dcc8"
      },
      "components": {
        "menu.bg": "{color.background}",
        "menu.hover": "{color.heroStart}",
        "nav.menuBg": "{color.background}",
        "nav.menuHover": "{color.heroStart}",
        "drawer.bg": "{color.background}",
        "drawer.activeBg": "{color.heroStart}",
        "dialog.bg": "{color.surfaceRaised}",
        "form.inputBg": "{color.surfaceRaised}",
        "form.sectionBg": "{color.surface}"
      },
      "materials": {
        "--m-glow": "color-mix(in srgb,var(--fanous-color-primary) 28%,transparent)",
        "--m-page": "radial-gradient(34% 26% at 12% 0%,color-mix(in srgb,var(--fanous-color-primary) 10%,transparent),transparent 72%),linear-gradient(180deg,#f3ead8,var(--fanous-color-background) 320px)",
        "--m-hero": "radial-gradient(46% 140% at 84% 0%,color-mix(in srgb,var(--fanous-color-primary) 30%,transparent),transparent 70%),linear-gradient(120deg,var(--fanous-color-surface-raised),var(--fanous-color-hero-start))",
        "--m-card": "linear-gradient(var(--fanous-color-surface),var(--fanous-color-surface))",
        "--m-border": "linear-gradient(var(--fanous-color-divider),var(--fanous-color-divider))",
        "--m-card-edge": "0 1px 2px rgb(11 37 52/.06),0 10px 24px -18px rgb(11 37 52/.28)",
        "--m-thumb-edge": "0 0 0 1px rgb(11 37 52/.08)",
        "--m-rail": "var(--fanous-color-background)",
        "--m-rail-edge": "inset -1px 0 0 var(--fanous-color-divider)",
        "--m-raised": "linear-gradient(var(--fanous-color-background),var(--fanous-color-background))",
        "--m-raised-edge": "0 0 0 1px var(--fanous-color-outline),0 18px 40px -18px rgb(11 37 52/.35)",
        "--m-active": "linear-gradient(var(--to-end),color-mix(in srgb,var(--fanous-color-primary) 26%,transparent),transparent 92%)",
        "--m-hover": "color-mix(in srgb,var(--fanous-color-hero-start) 70%,transparent)",
        "--m-sel": "color-mix(in srgb,var(--fanous-color-primary) 14%,transparent)",
        "--m-player": "0 0 0 1px var(--fanous-color-divider),0 20px 40px -24px rgb(11 37 52/.4)",
        "--m-player-ring": "inset 0 0 0 1px var(--fanous-color-divider)",
        "--m-dialog-line": "var(--fanous-color-divider)",
        "--m-dialog-shadow": "0 26px 50px -18px rgb(11 37 52/.35)"
      }
    },
