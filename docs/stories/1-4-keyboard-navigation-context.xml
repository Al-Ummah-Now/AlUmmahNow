  <acceptance-criteria>
    <criteria id="AC-1.4-1">
      <description>Given video player interface is loaded, when I navigate using only keyboard, then all interactive elements are reachable and operable</description>
      <type>functional</type>
      <wcag-reference>2.1.1 Keyboard</wcag-reference>
      <test-method>manual-automation</test-method>
    </criteria>
    <criteria id="AC-1.4-2">
      <description>Given keyboard navigation is active, when I tab through elements, then focus order is logical and predictable</description>
      <type>functional</type>
      <wcag-reference>2.4.3 Focus Order</wcag-reference>
      <test-method>manual-automation</test-method>
    </criteria>
    <criteria id="AC-1.4-3">
      <description>Given keyboard shortcuts are available, when I access help documentation, then keyboard shortcuts are documented and discoverable</description>
      <type>functional</type>
      <wcag-reference>2.4.6 Headings and Labels</wcag-reference>
      <test-method>manual</test-method>
    </criteria>
    <criteria id="AC-1.4-4">
      <description>Given page content is loaded, when I use keyboard navigation, then skip links are provided for main content areas</description>
      <type>functional</type>
      <wcag-reference>2.4.1 Bypass Blocks</wcag-reference>
      <test-method>manual-automation</test-method>
    </criteria>
    <criteria id="AC-1.4-5">
      <description>Given keyboard navigation is active, when I move between elements, then focus indicators are clearly visible</description>
      <type>visual</type>
      <wcag-reference>2.4.7 Focus Visible</wcag-reference>
      <test-method>visual-testing</test-method>
    </criteria>
    <criteria id="AC-1.4-6">
      <description>Given tab navigation is used, when I navigate interface, then Tab navigation works in consistent patterns</description>
      <type>functional</type>
      <wcag-reference>2.1.1 Keyboard</wcag-reference>
      <test-method>manual-automation</test-method>
    </criteria>
  </acceptance-criteria>

  <technical-requirements>
    <performance>
      <keyboard-response-time>&lt;16ms (60fps)</keyboard-response-time>
      <focus-indicator-rendering>&lt;16ms per frame</focus-indicator-rendering>
      <bundle-size-impact>&lt;500KB additional</bundle-size-impact>
    </performance>
    <browser-support>
      <chrome>full</chrome>
      <firefox>full</firefox>
      <safari>full</safari>
      <edge>full</edge>
    </browser-support>
    <accessibility-standards>
      <wcag-level>2.1 AA</wcag-level>
      <screen-reader-support>nvda,jaws,voiceover</screen-reader-support>
      <keyboard-navigation>complete</keyboard-navigation>
    </accessibility-standards>
  </technical-requirements>

  <existing-implementation>
    <keyboard-shortcuts>
      <file>apps/web/src/lib/video/keyboard-shortcuts.ts</file>
      <features>
        <youtube-style-shortcuts>true</youtube-style-shortcuts>
        <rtl-support>true</rtl-support>
        <security-validation>true</security-validation>
        <visual-feedback>true</visual-feedback>
        <rate-limiting>50ms (20 events/sec)</rate-limiting>
      </features>
      <shortcuts>
        <play-pause>[' ', 'k', 'K']</play-pause>
        <rewind>['ArrowLeft', 'j', 'J']</rewind>
        <forward>['ArrowRight', 'l', 'L']</forward>
        <volume-up>['ArrowUp']</volume-up>
        <volume-down>['ArrowDown']</volume-down>
        <mute>['m', 'M']</mute>
        <fullscreen>['f', 'F']</fullscreen>
        <pip>['p', 'P']</pip>
        <speed-decrease>[',', '&lt;']</speed-decrease>
        <speed-increase>['.', '&gt;']</speed-increase>
        <help>['?', '/']</help>
        <seek>{'0': 0, '1': 10, '2': 20, ..., '9': 90}</seek>
      </shortcuts>
    </keyboard-shortcuts>
    
    <accessibility-layer>
      <file>apps/web/src/lib/video/accessibility.ts</file>
      <features>
        <aria-labels>true</aria-labels>
        <screen-reader-announcements>true</screen-reader-announcements>
        <high-contrast-detection>true</high-contrast-detection>
        <focus-management>true</focus-management>
        <throttled-announcements>1000ms</throttled-announcements>
      </features>
    </accessibility-layer>

    <focus-management>
      <file>apps/web/src/hooks/useFocusTrap.ts</file>
      <features>
        <modal-focus-trap>true</modal-focus-trap>
        <tab-cycling>true</tab-cycling>
        <focus-restoration>true</focus-restoration>
        <wcag-compliance>2.1.1, 2.1.2, 2.4.3, 2.4.7</wcag-compliance>
      </features>
      <focusable-selector>
        <elements>
          <element>a[href]</element>
          <element>button:not([disabled])</element>
          <element>input:not([disabled])</element>
          <element>select:not([disabled])</element>
          <element>textarea:not([disabled])</element>
          <element>[tabindex]:not([tabindex="-1"])</element>
        </elements>
      </focusable-selector>
    </focus-management>

    <video-player-components>
      <main-component>apps/web/src/components/VideoPlayer/CustomVideoPlayer.tsx</main-component>
      <help-modal>apps/web/src/components/VideoPlayer/KeyboardHelpModal.tsx</help-modal>
      <controls>apps/web/src/components/videoPlayer/</controls>
      <rtl-variants>apps/web/src/components/*/rtl/</rtl-variants>
    </video-player-components>
  </existing-implementation>

