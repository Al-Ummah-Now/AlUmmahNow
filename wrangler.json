    "BunnyVideoKey": "",
    "BunnyVideoZone": "videos-mostafa-elbadry",
    "S3Api": "https://0e4b6e7f9faf280c3c9bf95995edc64f.r2.cloudflarestorage.com",
    "S3Key": "",
    "S3Secret": "",
    "S3Token": ""
  },
  "r2_buckets": [
    {
      "binding": "videos",
      "bucket_name": "videos"
    }
  ]
}
