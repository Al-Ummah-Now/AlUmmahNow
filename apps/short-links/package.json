{
  "name": "@al-ummah/short-links",
  "version": "1.0.0",
  "private": true,
  "description": "Short share links on alummahnow.link: redirects to the real pages, 404 for unknown ids, aggregate click counters (wiki AUN-SHORT-LINKS)",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --config wrangler.qa.jsonc",
    "deploy:qa": "wrangler deploy --config wrangler.qa.jsonc",
    "type-check": "tsc --noEmit",
    "test": "tsx --conditions=import --test test/*.test.ts",
    "lint": "eslint src test --ext .ts"
  },
  "dependencies": {
    "@al-ummah/logger": "workspace:*",
    "@al-ummah/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251106.1",
    "@eslint/js": "^9.39.1",
    "@types/node": "^20.0.0",
    "eslint": "9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "wrangler": "^4.108.0"
  }
}
