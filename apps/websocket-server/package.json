{
  "name": "@al-ummah/websocket-server",
  "version": "1.0.0",
  "private": true,
  "description": "Al Ummah Now - WebSocket Server with Cloudflare Durable Objects",
  "scripts": {
    "dev": "wrangler dev --inspector-port=4087",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "deploy:qa": "CI=true wrangler deploy --config wrangler.qa.jsonc",
    "cf-typegen": "wrangler types --env-file .dev.vars.example --strict-vars=false",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .wrangler",
    "verify": "node verify.js",
    "test": "tsx --import ./test/register-cf-stub.mjs --test test/*.test.ts",
    "lint": "eslint src"
  },
  "dependencies": {
    "@al-ummah-now/openauth": "1.0.15",
    "@al-ummah/logger": "workspace:*",
    "@al-ummah/shared-types": "workspace:*",
    "hono": "^4.13.11",
    "jose": "5.9.6",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "@types/node": "24.10.0",
    "typescript": "5.9.3",
    "wrangler": "^4.108.0",
    "ws": "^8.18.0"
  }
}
