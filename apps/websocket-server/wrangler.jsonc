/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "al-ummah-now-comms",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-12",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	/**
	 * Durable Objects
	 * https://developers.cloudflare.com/durable-objects/
	 */
	"durable_objects": {
		"bindings": [
			{
				"name": "WEBSOCKET_DO",
				"class_name": "WebSocketDurableObject",
				"script_name": "al-ummah-now-comms"
			}
		]
	},
	/**
	 * Migrations for Durable Objects
	 * https://developers.cloudflare.com/durable-objects/reference/durable-objects-migrations/
	 */
	"migrations": [
		{
			"tag": "v1",
			"new_classes": ["WebSocketDurableObject"]
		}
	],
	/**
	 * KV Namespace for presence tracking and state
	 */
	"kv_namespaces": [
		{
			"binding": "PRESENCE_KV",
			"id": "al-ummah-now-analytics-kv",
			"preview_id": "al-ummah-now-analytics-kv-preview"
		}
	],
	/**
	 * Environment Variables
	 */
	"vars": {},
	/**
	 * Development settings
	 */
	"dev": {
		"ip": "127.0.0.1",
		"port": 8787,
		"local_protocol": "http"
	}
}
