/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "al-ummah-now-comms",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-12",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	"observability": {
		"enabled": true,
		// Low traffic: keep every invocation. Lower this when traffic grows.
		"head_sampling_rate": 1,
		"logs": { "enabled": true, "head_sampling_rate": 1 }
	},
	/**
	 * Durable Objects
	 * https://developers.cloudflare.com/durable-objects/
	 */
	"durable_objects": {
		"bindings": [
			{
				"name": "WEBSOCKET_DO",
				"class_name": "WebSocketDurableObject"
			}
		]
	},
	/**
	 * Migrations for Durable Objects
	 * https://developers.cloudflare.com/durable-objects/reference/durable-objects-migrations/
	 */
	"migrations": [
		{
			"tag": "v1",
			"new_classes": ["WebSocketDurableObject"]
		}
	],
	/**
	 * Video JSON objects: the per-video view counter (src/view-counter.ts)
	 * flushes counts into them with conditional writes.
	 */
	"r2_buckets": [
		{ "binding": "VIDEOS", "bucket_name": "videos" }
	],
	"kv_namespaces": [
			// Token revocation list written by the auth worker (#437)
			{ "binding": "TOKEN_REVOCATIONS", "id": "2afbb5f5d5414c9ea1a7d54013cfe724", "preview_id": "e6e662fc9cd9420797ddfa8060eb6956" }
	],
	// Workers Rate Limiting (per location, no KV): socket opens per IP, client messages per user or IP
	"ratelimits": [
		{ "name": "WS_CONNECT_LIMITER", "namespace_id": "2301", "simple": { "limit": 120, "period": 60 } },
		{ "name": "WS_MESSAGE_LIMITER", "namespace_id": "2311", "simple": { "limit": 600, "period": 60 } }
	],
	/**
	 * Environment Variables
	 */
	"vars": {
		"ENVIRONMENT": "production",
		"WEBSOCKET_URL": "https://realtime.alummahnow.net",
		"Issuer": "https://auth.alummahnow.net"
	},
	/**
	 * Secrets Store
	 */
	"secrets_store_secrets": [
		{
			"binding": "INTERNAL_API_KEY",
			"store_id": "f8eddc9944d041919ed8dc7d08d32308",
			"secret_name": "internal-api-key"
		}
	],
	/**
	 * Development settings
	 */
	"dev": {
		"ip": "127.0.0.1",
		"port": 3087,
		"local_protocol": "http"
	},
	"env": {
		// Stage slot (docs/release-pipeline): same bindings as production, stage resources and hosts.
		"stage": {
			// Workers Logs bills per line: log 10% of invocations (sampling drops errors too)
			"observability": { "enabled": true, "head_sampling_rate": 0.1, "logs": { "enabled": true, "head_sampling_rate": 0.1 } },
			"version_metadata": { "binding": "CF_VERSION_METADATA" },
			"name": "al-ummah-now-comms-stage",
			"routes": [
				{
					"pattern": "realtime.stage.alummahnow.net",
					"custom_domain": true
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "WEBSOCKET_DO",
						"class_name": "WebSocketDurableObject"
					}
				]
			},
			"r2_buckets": [
				{ "binding": "VIDEOS", "bucket_name": "videos-stage" }
			],
			"kv_namespaces": [
			// Token revocation list written by the auth worker (#437)
			{ "binding": "TOKEN_REVOCATIONS", "id": "0831520b71144a6e848ed62918602c13" }
			],
			// Workers Rate Limiting (per location, no KV): socket opens per IP, client messages per user or IP
			"ratelimits": [
				{ "name": "WS_CONNECT_LIMITER", "namespace_id": "2302", "simple": { "limit": 120, "period": 60 } },
				{ "name": "WS_MESSAGE_LIMITER", "namespace_id": "2312", "simple": { "limit": 600, "period": 60 } }
			],
			"vars": {
				"ENVIRONMENT": "stage",
				"WEBSOCKET_URL": "https://realtime.stage.alummahnow.net",
				"Issuer": "https://auth.stage.alummahnow.net"
			},
			"secrets_store_secrets": [
				{
					"binding": "INTERNAL_API_KEY",
					"store_id": "f8eddc9944d041919ed8dc7d08d32308",
					"secret_name": "internal-api-key-stage"
				}
			]
		}
	}
}
