/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "al-ummah-now-comms",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-12",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	"observability": {
		"enabled": true
	},
	/**
	 * Durable Objects
	 * https://developers.cloudflare.com/durable-objects/
	 */
	"durable_objects": {
		"bindings": [
			{
				"name": "WEBSOCKET_DO",
				"class_name": "WebSocketDurableObject"
			}
		]
	},
	/**
	 * Migrations for Durable Objects
	 * https://developers.cloudflare.com/durable-objects/reference/durable-objects-migrations/
	 */
	"migrations": [
		{
			"tag": "v1",
			"new_classes": ["WebSocketDurableObject"]
		}
	],
	/**
	 * KV Namespace for presence tracking and state
	 */
	"kv_namespaces": [
		{
			"binding": "PRESENCE_KV",
			"id": "a3dbf9b2b80c4a3ea101281e19fd8407",
			"preview_id": "156bbaeac14b4d0da721673e951bef3e",
			"remote": true
		}
	],
	/**
	 * Environment Variables
	 */
	"vars": {
		"ENVIRONMENT": "production",
		"WEBSOCKET_URL": "https://realtime.alummahnow.net",
		"Issuer": "https://auth.alummahnow.net"
	},
	/**
	 * Secrets Store
	 */
	"secrets_store_secrets": [
		{
			"binding": "INTERNAL_API_KEY",
			"store_id": "f8eddc9944d041919ed8dc7d08d32308",
			"secret_name": "internal-api-key"
		}
	],
	/**
	 * Development settings
	 */
	"dev": {
		"ip": "127.0.0.1",
		"port": 3087,
		"local_protocol": "http"
	},
	"env": {
		// Stage slot (docs/release-pipeline): same bindings as production, stage resources and hosts.
		"stage": {
			"version_metadata": { "binding": "CF_VERSION_METADATA" },
			"name": "al-ummah-now-comms-stage",
			"routes": [
				{
					"pattern": "realtime.stage.alummahnow.net",
					"custom_domain": true
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "WEBSOCKET_DO",
						"class_name": "WebSocketDurableObject"
					}
				]
			},
			"kv_namespaces": [
				{
					"binding": "PRESENCE_KV",
					"id": "03ba69245a7c40f4952ac5e0a9b402ca"
				}
			],
			"vars": {
				"ENVIRONMENT": "stage",
				"WEBSOCKET_URL": "https://realtime.stage.alummahnow.net",
				"Issuer": "https://auth.stage.alummahnow.net"
			},
			"secrets_store_secrets": [
				{
					"binding": "INTERNAL_API_KEY",
					"store_id": "f8eddc9944d041919ed8dc7d08d32308",
					"secret_name": "internal-api-key-stage"
				}
			]
		}
	}
}
