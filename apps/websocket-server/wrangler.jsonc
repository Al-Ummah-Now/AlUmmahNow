/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "al-ummah-now-comms",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-12",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	/**
	 * Durable Objects
	 * https://developers.cloudflare.com/durable-objects/
	 */
	"durable_objects": {
		"bindings": [
			{
				"name": "WEBSOCKET_DO",
				"class_name": "WebSocketDurableObject"
			}
		]
	},
	/**
	 * Migrations for Durable Objects
	 * https://developers.cloudflare.com/durable-objects/reference/durable-objects-migrations/
	 */
	"migrations": [
		{
			"tag": "v1",
			"new_classes": ["WebSocketDurableObject"]
		}
	],
	/**
	 * KV Namespace for presence tracking and state
	 */
	"kv_namespaces": [
		{
			"binding": "PRESENCE_KV",
			"id": "a3dbf9b2b80c4a3ea101281e19fd8407",
			"preview_id": "156bbaeac14b4d0da721673e951bef3e",
			"remote": true
		}
	],
	/**
	 * Environment Variables
	 */
	"vars": {
		"ENVIRONMENT": "production",
		"WEBSOCKET_URL": "https://realtime.alummahnow.net",
		"Issuer": "https://auth.alummahnow.net",
		"ALLOWED_CLIENT_IDS": "3f8c9b2e-4d6a-4b8e-9f3a-2c7d5e8f1a6b"
	},
	/**
	 * Secrets Store
	 */
	"secrets_store_secrets": [
		{
			"binding": "INTERNAL_API_KEY",
			"store_id": "f8eddc9944d041919ed8dc7d08d32308",
			"secret_name": "internal-api-key"
		}
	],
	/**
	 * Development settings
	 */
	"dev": {
		"ip": "127.0.0.1",
		"port": 3087,
		"local_protocol": "http"
	}
}
