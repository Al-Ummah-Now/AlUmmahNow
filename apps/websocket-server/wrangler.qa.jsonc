{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "al-ummah-now-comms-qa",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    // Workers Logs bills per line: log 10% of invocations (sampling drops errors too)
    "head_sampling_rate": 0.1,
    "logs": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WEBSOCKET_DO",
        "class_name": "WebSocketDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["WebSocketDurableObject"]
    }
  ],
  "kv_namespaces": [
			// Token revocation list written by the auth worker (#437)
			{ "binding": "TOKEN_REVOCATIONS", "id": "e6e662fc9cd9420797ddfa8060eb6956" },
    {
      "binding": "PRESENCE_KV",
      "id": "2cf049fac822401fab2ef3fcb0675c8a"
    }
  ],
  "vars": {
    "ENVIRONMENT": "qa",
    "WEBSOCKET_URL": "https://realtime.qa.alummahnow.net",
    "Issuer": "https://auth.qa.alummahnow.net"
  },
  "secrets_store_secrets": [
    {
      "binding": "INTERNAL_API_KEY",
      "store_id": "f8eddc9944d041919ed8dc7d08d32308",
      "secret_name": "internal-api-key-qa"
    }
  ],
  "dev": {
    "ip": "127.0.0.1",
    "port": 3087,
    "local_protocol": "http"
  }
}
