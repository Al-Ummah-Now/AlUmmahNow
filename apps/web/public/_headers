# Cloudflare Workers static-asset headers (copied to .open-next/assets).
# Next.js build output under /_next/static is content-hashed, so it can be
# cached forever; without this the assets are served with max-age=0.
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Embedded discussions widget (docs/embeds/README.md §7): loaded by other sites
/embed/widget.js
  Cache-Control: public,max-age=3600
  Access-Control-Allow-Origin: *

# Logo files: small and fixed per name, so browsers keep them for a week
/brand/*
  Cache-Control: public,max-age=604800,stale-while-revalidate=86400

# Tab and app icons: fixed names, so a day fresh and a week stale-while-revalidate
/favicon*
  Cache-Control: public,max-age=86400,stale-while-revalidate=604800
/apple-touch-icon.png
  Cache-Control: public,max-age=86400,stale-while-revalidate=604800
/icon-*
  Cache-Control: public,max-age=86400,stale-while-revalidate=604800
/site.webmanifest
  Cache-Control: public,max-age=86400,stale-while-revalidate=604800
