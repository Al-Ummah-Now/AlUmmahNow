# Al Ummah Now - Environment Configuration
# Copy this file to .env.local and fill in your actual values

# ==============================================================================
# Bunny.net Stream Configuration
# ==============================================================================
# These environment variables configure the BunnyStreamService for generating
# video streaming URLs. Get these values from your Bunny.net dashboard.

# Pull Zone URL (e.g., "vz-xxxxx.b-cdn.net")
# This is the CDN URL for your video pull zone
# Find it at: Bunny.net Dashboard > Video Library > Settings > Pull Zone
NEXT_PUBLIC_BUNNY_PULL_ZONE_URL=vz-your-pull-zone.b-cdn.net

# Library ID (numeric value as string, e.g., "12345")
# This is your Bunny.net Stream library identifier
# Find it at: Bunny.net Dashboard > Video Library > Settings > Library ID
NEXT_PUBLIC_BUNNY_LIBRARY_ID=your-library-id

# API Key (optional, for authenticated requests)
# Used for API calls to Bunny.net (e.g., uploading videos)
# Find it at: Bunny.net Dashboard > Account Settings > API Keys
# Note: This is optional and only needed if you're making direct API calls
NEXT_PUBLIC_BUNNY_API_KEY=your-api-key-here

# Token Authentication (optional, for future use)
# Set to "true" to enable token-based URL authentication
# Default: false
NEXT_PUBLIC_BUNNY_TOKEN_AUTH=false

# ==============================================================================
# WebSocket Configuration
# ==============================================================================
# WebSocket server URL for real-time video metrics
# Production: wss://realtime.alummahnow.net/ws
# Development: ws://localhost:3087/ws
# This enables real-time viewer counts and viewing heartbeats
NEXT_PUBLIC_WEBSOCKET_URL=wss://realtime.alummahnow.net/ws

# ==============================================================================
# Other Configuration (if needed)
# ==============================================================================
# Add other environment variables here as needed
