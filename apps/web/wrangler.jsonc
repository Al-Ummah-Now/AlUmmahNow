{
  "name": "al-ummah-now-dev",
  "main": "worker.ts",
  "compatibility_date": "2025-04-12",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
    // Skew protection fetches an old version through its workers.dev preview URL.
    // Without this flag a Worker's fetch to a workers.dev URL of its own account
    // fails (error 1042, a 522 on the custom domain): release v2026.11.10.4.
    "global_fetch_strictly_public"
  ],
  "logpush": true,
  "minify": true,
  // esbuild keepNames injects __name() into fn.toString() output, breaking
  // next-themes inline script in the browser ("e is not defined").
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // The Worker sees chunk requests first, so `?dpl=<old build>` reaches the
    // old version's assets (skew protection). Must match in every config: the
    // OpenNext build reads it from wrangler.jsonc.
    "run_worker_first": ["/_next/static/*"],
    // Public files only at their exact path, as Next.js serves them, so no
    // alias (/foo for /foo.html) skips the middleware. OpenNext >= 1.20.10
    // refuses to build otherwise when run_worker_first is set.
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "vars": {
    // Local development (next dev) talks to QA, never production: the routes that forward with the
    // internal key would otherwise call production (2026-11-18). apps/web/src/__tests__/dev-config.test.ts
    // Logging policy (docs/operations/logging.md): warn on production, stage and QA (only warnings, errors, slow requests); debug locally
    "LOG_LEVEL": "debug",
    "Issuer": "https://auth.qa.alummahnow.net",
    "OPENAUTH_ISSUER": "https://auth.qa.alummahnow.net",
    "NEXTJS_ENV": "development",
    "API_URL": "https://videos.api.qa.alummahnow.net",
    "ADMIN_API_URL": "https://admin.api.qa.alummahnow.net",
    "ClientId": "f0de3c30-0304-4ac4-86d6-1e185dec0439"
  },
  "images": { "binding": "IMAGES" },
  "r2_buckets": [
    {
      "binding": "videos",
      "bucket_name": "videos"
    }
  ],
  "kv_namespaces": [
    // Token revocation list shared with auth and APIs (#437, #762)
    { "binding": "TOKEN_REVOCATIONS", "id": "2afbb5f5d5414c9ea1a7d54013cfe724", "preview_id": "e6e662fc9cd9420797ddfa8060eb6956" }
  ]
}
