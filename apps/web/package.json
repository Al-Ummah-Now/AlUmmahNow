{
  "name": "@al-ummah/web",
  "version": "1.0.0",
  "private": true,
  "description": "Al Ummah Now - Video Portal UI",
  "dependencies": {
    "@al-ummah/logger": "workspace:*",
    "@al-ummah/shared-types": "workspace:*",
    "@aws-sdk/client-s3": "^3.926.0",
    "@openauthjs/openauth": "^0.4.3",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@videojs/http-streaming": "^3.17.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.487.0",
    "next": "^16.0.1",
    "next-themes": "^0.4.6",
    "nuqs": "^2.7.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "^3.2.0",
    "tw-animate-css": "^1.2.5",
    "valibot": "^1.0.0",
    "video.js": "^8.23.4",
    "videojs-contrib-quality-levels": "^4.1.0",
    "videojs-hls-quality-selector": "^2.0.0",
    "videojs-sprite-thumbnails": "^2.2.4",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@opennextjs/aws": "^3.8.5",
    "@opennextjs/cloudflare": "^1.11.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "@types/react": "18.2.19",
    "@types/react-dom": "^18",
    "@types/video.js": "^7.3.58",
    "@typescript-eslint/eslint-plugin": "8.46.4",
    "@typescript-eslint/parser": "8.46.4",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.6",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "playwright": "^1.56.1",
    "postcss": "8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "5.9.3",
    "wrangler": "^4.46.0"
  },
  "scripts": {
    "dev": "next dev -p 3001 --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "clean": "rm -rf .next .open-next node_modules",
    "check": "opennextjs-cloudflare build && tsc && wrangler deploy --dry-run",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "deploy:staging": "opennextjs-cloudflare build && wrangler deploy --config wrangler.staging.jsonc",
    "deploy:production": "opennextjs-cloudflare build && wrangler deploy --config wrangler.production.jsonc",
    "deploy:preview": "opennextjs-cloudflare build && wrangler deploy --config wrangler.preview.jsonc",
    "preview": "opennextjs-cloudflare build && wrangler dev",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "logs": "wrangler tail",
    "logs:staging": "wrangler tail --config wrangler.staging.jsonc",
    "logs:production": "wrangler tail --config wrangler.production.jsonc",
    "logs:preview": "wrangler tail --config wrangler.preview.jsonc"
  }
}
