{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "al-ummah-web-qa",
  "main": "worker.ts",
  // Skew protection: old pages are served by the Worker version that built
  // them, through that version's preview URL (open-next.config.ts)
  "preview_urls": true,
  "compatibility_date": "2025-04-12",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
    // Skew protection fetches an old version through its workers.dev preview URL.
    // Without this flag a Worker's fetch to a workers.dev URL of its own account
    // fails (error 1042, a 522 on the custom domain): release v2026.11.10.4.
    "global_fetch_strictly_public"
  ],
  "logpush": false,
  "minify": true,
  // esbuild keepNames injects __name() into fn.toString() output, breaking
  // next-themes inline script in the browser ("e is not defined").
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // The Worker sees chunk requests first, so `?dpl=<old build>` reaches the
    // old version's assets (skew protection). Must match in every config: the
    // OpenNext build reads it from wrangler.jsonc.
    "run_worker_first": ["/_next/static/*"]
  },
  "observability": {
    "enabled": true,
    // Workers Logs bills per line (docs/operations/logging.md): keep every invocation
    // (head sampling would drop errors too), no automatic per-invocation log, and
    // LOG_LEVEL warn below, so only warnings, errors and slow requests are written
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false }
  },
  "upload_source_maps": true,
  "vars": {
    // Logging policy (docs/operations/logging.md): warn on production, stage and QA (only warnings, errors, slow requests); debug locally
    "LOG_LEVEL": "warn",
    "CF_WORKER_NAME": "al-ummah-web-qa",
    "CF_PREVIEW_DOMAIN": "mahmoud-s-darwish",
    "Issuer": "https://auth.qa.alummahnow.net",
    "OPENAUTH_ISSUER": "https://auth.qa.alummahnow.net",
    "NEXTJS_ENV": "qa",
    "API_URL": "https://videos.api.qa.alummahnow.net",
    "ADMIN_API_URL": "https://admin.api.qa.alummahnow.net",
    "ERRORS_INGEST_URL": "https://admin.api.qa.alummahnow.net/internal/errors",
    "WEBSOCKET_URL": "wss://realtime.qa.alummahnow.net/ws",
    "ClientId": "e0de3c30-0304-4ac4-86d6-1e185dec0439"
  },
  "r2_buckets": [
    {
      "binding": "videos",
      "bucket_name": "videos-qa"
    }
  ],
  // Worker version id sent with error reports (admin Errors page)
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "secrets_store_secrets": [
    // X-API-Key for admin-api /internal/contact (app/api/contact/route.ts)
    { "binding": "INTERNAL_API_KEY", "store_id": "f8eddc9944d041919ed8dc7d08d32308", "secret_name": "internal-api-key-qa" }
  ]
}
