{
  "name": "al-ummah-now-production",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-12",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "logpush": true,
  "minify": true,
  // esbuild keepNames injects __name() into fn.toString() output, breaking
  // next-themes inline script in the browser ("e is not defined").
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    // Low traffic: keep every invocation. Lower this when traffic grows.
    "head_sampling_rate": 1
  },
  "upload_source_maps": true,
  "vars": {
    "Issuer": "https://auth.alummahnow.net",
    "OPENAUTH_ISSUER": "https://auth.alummahnow.net",
    "NEXTJS_ENV": "production",
    "API_URL": "https://videos.api.alummahnow.net",
    "WEBSOCKET_URL": "wss://realtime.alummahnow.net/ws",
    "ClientId": "f0de3c30-0304-4ac4-86d6-1e185dec0439"
  },
  "r2_buckets": [
    {
      "binding": "videos",
      "bucket_name": "videos"
    }
  ],
  "env": {
    // Stage slot (docs/release-pipeline): same bindings as production, stage resources and hosts.
    "stage": {
      // Workers Logs bills per line: log 10% of invocations (sampling drops errors too)
      "observability": { "enabled": true, "head_sampling_rate": 0.1 },
      "name": "al-ummah-now-stage",
      "routes": [
        {
          "pattern": "videos.stage.alummahnow.net",
          "custom_domain": true
        }
      ],
      "vars": {
        "Issuer": "https://auth.stage.alummahnow.net",
        "OPENAUTH_ISSUER": "https://auth.stage.alummahnow.net",
        "NEXTJS_ENV": "stage",
        "API_URL": "https://videos.api.stage.alummahnow.net",
        "WEBSOCKET_URL": "wss://realtime.stage.alummahnow.net/ws",
        "ClientId": "f0de3c30-0304-4ac4-86d6-1e185dec0439"
      },
      "r2_buckets": [
        {
          "binding": "videos",
          "bucket_name": "videos-stage"
        }
      ]
    }
  }
}
