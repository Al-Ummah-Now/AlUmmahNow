{
	"name": "al-ummah-admin-api",
	"main": "src/index.ts",
	"compatibility_date": "2024-09-01",
	"compatibility_flags": ["nodejs_compat"],
	"version_metadata": { "binding": "CF_VERSION_METADATA" },

	// Production custom domain (zone alummahnow.net)
	"routes": [
		{
			"pattern": "admin.api.alummahnow.net",
			"custom_domain": true
		}
	],

	// D1 database for moderation reports
	"d1_databases": [
		{
			"binding": "REPORTS_DB",
			"database_name": "al-ummah-now-reports",
			"database_id": "7bee932d-c6b1-47c2-ab70-7dba349104af",
			"preview_database_id": "2d6a536c-6546-48c2-840a-40f9ddc21ab8",
			"migrations_dir": "migrations",
			"remote": true
		},
		{
			// Search index (read only here): the section index rebuild reads it (SCALABILITY-AUDIT AA-4).
			// Migrations live in apps/api-videos.
			"binding": "SEARCH_DB",
			"database_name": "al-ummah-now-search",
			"database_id": "41064871-cf1f-46e9-b102-7b913240ad89"
		},
		{
			// Platform analytics rollups (read; writes only ops_thresholds). Migrations in apps/cost-monitor.
			"binding": "COSTS_DB",
			"database_name": "al-ummah-now-costs",
			"database_id": "af54e39e-6faa-4923-bba3-8dd7b3e58cf7"
		}
	],

	// R2 buckets for content access (read/update for moderation)
	// Token revocation list written by the auth worker (#437)
	"kv_namespaces": [{ "binding": "TOKEN_REVOCATIONS", "id": "2afbb5f5d5414c9ea1a7d54013cfe724", "preview_id": "e6e662fc9cd9420797ddfa8060eb6956" }],
	"r2_buckets": [
		{
			"binding": "videos",
			"bucket_name": "videos",
			"preview_bucket_name": "videos-preview",
			"remote": true
		},
		{
			"binding": "channels",
			"bucket_name": "channels",
			"preview_bucket_name": "channels-preview",
			"remote": true
		},
		{
			"binding": "profiles",
			"bucket_name": "profiles",
			"preview_bucket_name": "profiles-preview",
			"remote": true
		},
		{
			"binding": "playlists",
			"bucket_name": "playlists",
			"preview_bucket_name": "playlists-preview",
			"remote": true
		},
		{
			"binding": "global_settings",
			"bucket_name": "global-settings",
			"preview_bucket_name": "global-settings-preview",
			"remote": true
		},
		{
			// Read by AI moderation review (Epic 28) to show post text
			"binding": "community_posts",
			"bucket_name": "community-posts",
			"preview_bucket_name": "community-posts-preview",
			"remote": true
		},
		{
			// Theme packages made in the admin theme builder (src/lib/themePackages.ts)
			"binding": "theme_packages",
			"bucket_name": "theme-packages",
			"preview_bucket_name": "theme-packages-preview",
			"remote": true
		},
		{
			// Private source maps (release uploads; symbolicates browser stacks on the Errors page)
			"binding": "SOURCEMAPS",
			"bucket_name": "al-ummah-now-sourcemaps"
		}
	],

	// Queue for notifications
	"queues": {
		"producers": [
			{
				"binding": "queue",
				"queue": "al-ummah-now-videos"
			},
			// Contact us mail jobs (lib/contact-mail-queue.ts), consumed below
			{ "binding": "CONTACT_MAIL_QUEUE", "queue": "al-ummah-now-contact-mail" },
			// Final mail failures → platform DLQ (processor stores them in dead_letters)
			{ "binding": "ERRORS_DLQ", "queue": "al-ummah-now-dlq" },
			// Requests to auth: sends, answers and status reads, with retries (src/lib/authModerationQueue.ts)
			{ "binding": "AUTH_REQUESTS_QUEUE", "queue": "auth-moderation-requests" },
			{
				// Error ingest (endpoints/errors/ErrorsIngest.ts): /internal/errors enqueues, this Worker writes D1
				"binding": "ERRORS_QUEUE",
				"queue": "al-ummah-now-errors"
			},
			// Short/video format backfill runs on api-videos' processing-check queue (apps/api-videos/src/lib/video-format/job.ts)
			{ "binding": "PROCESSING_CHECK_QUEUE", "queue": "al-ummah-now-processing-check" }
		],
		"consumers": [
			{
				// Retries back off in code (msg.retry delaySeconds); keep max_retries = MAX_ATTEMPTS - 1
				"queue": "al-ummah-now-contact-mail",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 5,
				"dead_letter_queue": "al-ummah-now-dlq"
			},
			{ "queue": "auth-moderation-requests", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 6, "retry_delay": 30, "dead_letter_queue": "auth-moderation-requests-dlq" },
			{ "queue": "auth-moderation-requests-dlq", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 3 },
			{
				"queue": "al-ummah-now-errors",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 5,
				"dead_letter_queue": "al-ummah-now-errors-dlq"
			},
			{
				// Batches that failed 5 times: retried every 15 minutes, no DLQ of its own
				"queue": "al-ummah-now-errors-dlq",
				"max_batch_size": 10,
				"max_batch_timeout": 30,
				"max_retries": 10
			}
		]
	},
	// Every 5 minutes: status reads of open requests to auth; 03:17 UTC: error data retention
	"triggers": { "crons": ["*/5 * * * *", "17 3 * * *"] },
	// Private source maps uploaded by the release (lib/sourcemaps.ts) are in r2_buckets as SOURCEMAPS.
	// VIDEOS: api-videos owns the content data: /internal/* (processing health, content management)
	// PROCESSOR, SCHEDULER: Retry actions on the Errors page (lib/errors-actions.ts): dead letters, failed scheduled publishes
	"services": [
		{ "binding": "VIDEOS", "service": "videos" },
		{ "binding": "PROCESSOR", "service": "al-ummah-now-processor" },
		{ "binding": "SCHEDULER", "service": "al-ummah-scheduler" }
	],

	// Environment variables
	"vars": {
		"ENVIRONMENT": "production",
		// Logging policy (docs/operations/logging.md): warn on production, stage and QA (only warnings, errors, slow requests); debug locally
		"LOG_LEVEL": "warn",
		"WEBSOCKET_URL": "https://realtime.alummahnow.net",
		"Issuer": "https://auth.alummahnow.net",
		// Shown in admin when D1 has no cap; keep equal to the processor's value
		"AI_MODERATION_DAILY_NEURON_CAP": "100000",
		// Contact us: support inbox notified of new messages (Reply-To of mail to senders) and the inbox link
		"CONTACT_INBOX": "support@alummahnow.net",
		// Moderation requests to auth: this app's auth client (secret: worker secret
		// AUTH_MODERATION_CLIENT_SECRET) and the admin web for evidence links
		"AUTH_MODERATION_CLIENT_ID": "d7464de8-363d-4fc1-b1af-7c71653f0afc",
		"ADMIN_WEB_URL": "https://admin.alummahnow.net"
	},

	// Secrets Store
	"secrets_store_secrets": [
		{
			"binding": "INTERNAL_API_KEY",
			"store_id": "f8eddc9944d041919ed8dc7d08d32308",
			"secret_name": "internal-api-key"
		},
		{
			// Contact us mail (lib/contact-email.ts); the auth server's Resend key
			"binding": "RESEND_API_KEY",
			"store_id": "f8eddc9944d041919ed8dc7d08d32308",
			"secret_name": "RESEND_API_KEY"
		}
	],

	// Environment-specific configurations
	"env": {
		// Stage slot (docs/release-pipeline): same bindings as production, stage resources and hosts.
		"stage": {
			// Workers Logs bills per line: every invocation kept (sampling would drop errors), no invocation log, LOG_LEVEL warn
			"observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false } },
			"version_metadata": { "binding": "CF_VERSION_METADATA" },
			"name": "al-ummah-admin-api-stage",
			"routes": [
				{
					"pattern": "admin.api.stage.alummahnow.net",
					"custom_domain": true
				}
			],
			"d1_databases": [
				{
					"binding": "REPORTS_DB",
					"database_name": "al-ummah-now-reports-stage",
					"database_id": "2b2c07fc-2823-46e0-958f-acfc401544ff",
					"migrations_dir": "migrations"
				},
				{
					// Search index (read only; migrations in apps/api-videos)
					"binding": "SEARCH_DB",
					"database_name": "al-ummah-now-search-stage",
					"database_id": "956a3550-bd20-4cfc-9bf2-b1c2265b33dd"
				},
				{
					// Platform analytics rollups (migrations in apps/cost-monitor)
					"binding": "COSTS_DB",
					"database_name": "al-ummah-now-costs-stage",
					"database_id": "d4c4d007-c691-4f92-a728-b2ecd706a3ae"
				}
			],
			// Token revocation list written by the auth worker (#437)
	"kv_namespaces": [{ "binding": "TOKEN_REVOCATIONS", "id": "0831520b71144a6e848ed62918602c13" }],
	"r2_buckets": [
				{
					"binding": "videos",
					"bucket_name": "videos-stage"
				},
				{
					"binding": "channels",
					"bucket_name": "channels-stage"
				},
				{
					"binding": "profiles",
					"bucket_name": "profiles-stage"
				},
				{
					"binding": "playlists",
					"bucket_name": "playlists-stage"
				},
				{
					"binding": "global_settings",
					"bucket_name": "global-settings-stage"
				},
				{
					"binding": "community_posts",
					"bucket_name": "community-posts-stage"
				},
				{
					"binding": "theme_packages",
					"bucket_name": "theme-packages-stage"
				},
				{
					"binding": "SOURCEMAPS",
					"bucket_name": "al-ummah-now-sourcemaps-stage"
				}
			],
			"queues": {
				"producers": [
					{
						"binding": "queue",
						"queue": "al-ummah-now-videos-stage"
					},
					// Contact us mail jobs (lib/contact-mail-queue.ts), consumed below
					{ "binding": "CONTACT_MAIL_QUEUE", "queue": "al-ummah-now-contact-mail-stage" },
					// Final mail failures → platform DLQ (processor stores them in dead_letters)
					{ "binding": "ERRORS_DLQ", "queue": "al-ummah-now-dlq-stage" },
					// Requests to auth: sends, answers and status reads, with retries (src/lib/authModerationQueue.ts)
					{ "binding": "AUTH_REQUESTS_QUEUE", "queue": "auth-moderation-requests-stage" },
					{
						// Error ingest (endpoints/errors/ErrorsIngest.ts): /internal/errors enqueues, this Worker writes D1
						"binding": "ERRORS_QUEUE",
						"queue": "al-ummah-now-errors-stage"
					},
					// Short/video format backfill runs on api-videos' processing-check queue (apps/api-videos/src/lib/video-format/job.ts)
					{ "binding": "PROCESSING_CHECK_QUEUE", "queue": "al-ummah-now-processing-check-stage" }
				],
				"consumers": [
					{
						// Retries back off in code (msg.retry delaySeconds); keep max_retries = MAX_ATTEMPTS - 1
						"queue": "al-ummah-now-contact-mail-stage",
						"max_batch_size": 10,
						"max_batch_timeout": 5,
						"max_retries": 5,
						"dead_letter_queue": "al-ummah-now-dlq-stage"
					},
					{ "queue": "auth-moderation-requests-stage", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 6, "retry_delay": 30, "dead_letter_queue": "auth-moderation-requests-dlq-stage" },
					{ "queue": "auth-moderation-requests-dlq-stage", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 3 },
					{
						"queue": "al-ummah-now-errors-stage",
						"max_batch_size": 10,
						"max_batch_timeout": 5,
						"max_retries": 5,
						"dead_letter_queue": "al-ummah-now-errors-dlq-stage"
					},
					{
						// Batches that failed 5 times: retried every 15 minutes, no DLQ of its own
						"queue": "al-ummah-now-errors-dlq-stage",
						"max_batch_size": 10,
						"max_batch_timeout": 30,
						"max_retries": 10
					}
				]
			},
			// Every 5 minutes: status reads of open requests to auth; 03:17 UTC: error data retention
			"triggers": { "crons": ["*/5 * * * *", "17 3 * * *"] },
			// VIDEOS: content data; PROCESSOR, SCHEDULER: Retry actions on the Errors page (lib/errors-actions.ts)
			"services": [
				{ "binding": "VIDEOS", "service": "videos-stage" },
				{ "binding": "PROCESSOR", "service": "al-ummah-now-processor-stage" },
				{ "binding": "SCHEDULER", "service": "al-ummah-scheduler-stage" }
			],
			"vars": {
				"ENVIRONMENT": "stage",
				// Logging policy (docs/operations/logging.md): warn on production, stage and QA (only warnings, errors, slow requests); debug locally
				"LOG_LEVEL": "warn",
				"WEBSOCKET_URL": "https://realtime.stage.alummahnow.net",
				"Issuer": "https://auth.stage.alummahnow.net",
				// Shown in admin when D1 has no cap; keep equal to the processor's value
				"AI_MODERATION_DAILY_NEURON_CAP": "10000",
				"CONTACT_INBOX": "support@alummahnow.net",
				"AUTH_MODERATION_CLIENT_ID": "d7464de8-363d-4fc1-b1af-7c71653f0afc",
				"ADMIN_WEB_URL": "https://admin.stage.alummahnow.net"
			},
			"secrets_store_secrets": [
				{
					"binding": "INTERNAL_API_KEY",
					"store_id": "f8eddc9944d041919ed8dc7d08d32308",
					"secret_name": "internal-api-key-stage"
				},
				{
					"binding": "RESEND_API_KEY",
					"store_id": "f8eddc9944d041919ed8dc7d08d32308",
					"secret_name": "RESEND_API_KEY"
				}
			]
		},
		"development": {
			"vars": {
				"ENVIRONMENT": "development",
				// Logging policy (docs/operations/logging.md): warn on production, stage and QA (only warnings, errors, slow requests); debug locally
				"LOG_LEVEL": "debug",
				"WEBSOCKET_URL": "http://localhost:3087",
				"VIDEOS_API_URL": "http://127.0.0.1:3086",
				"INTERNAL_API_KEY": "dev-internal-api-key",
				"ADMIN_WEB_URL": "http://localhost:3091"
			}
		},
		"staging": {
			"vars": {
				"ENVIRONMENT": "staging",
				// Logging policy (docs/operations/logging.md): warn on production, stage and QA (only warnings, errors, slow requests); debug locally
				"LOG_LEVEL": "info"
			}
		}
	},

	// Observability
	"observability": {
		"enabled": true,
		// Low traffic (admins only): every invocation and its invocation log are kept (docs/operations/logging.md).
		"head_sampling_rate": 1,
		"logs": { "enabled": true, "head_sampling_rate": 1 }
	},

	// Development server configuration
	"dev": {
		"ip": "127.0.0.1",
		"port": 3090,
		"local_protocol": "http"
	}
}
