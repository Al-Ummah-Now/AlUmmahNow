{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "al-ummah-admin-api-qa",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "REPORTS_DB",
      "database_name": "al-ummah-now-reports-qa",
      "database_id": "eed66c4a-af26-4e07-9f9a-36f1e4ada555",
      "migrations_dir": "migrations"
    },
    {
      // Search index (read only; migrations in apps/api-videos): section index rebuild (SCALABILITY-AUDIT AA-4)
      "binding": "SEARCH_DB",
      "database_name": "al-ummah-now-search-qa",
      "database_id": "0282bac3-5b70-4343-a991-937c732d981a"
    }
  ],

  // Token revocation list written by the auth worker (#437)
	"kv_namespaces": [{ "binding": "TOKEN_REVOCATIONS", "id": "e6e662fc9cd9420797ddfa8060eb6956" }],
	"r2_buckets": [
    {
      "binding": "videos",
      "bucket_name": "videos-qa"
    },
    {
      "binding": "channels",
      "bucket_name": "channels-qa"
    },
    {
      "binding": "profiles",
      "bucket_name": "profiles-qa"
    },
    {
      "binding": "playlists",
      "bucket_name": "playlists-qa"
    },
    {
      "binding": "global_settings",
      "bucket_name": "global-settings-qa"
    },
    {
      "binding": "community_posts",
      "bucket_name": "community-posts-qa"
    },
    {
      "binding": "theme_packages",
      "bucket_name": "theme-packages-qa"
    },
    {
      // Private source maps (deploy.yml uploads them for QA builds)
      "binding": "SOURCEMAPS",
      "bucket_name": "al-ummah-now-sourcemaps-qa"
    }
  ],

  "queues": {
    "producers": [
      {
        "binding": "queue",
        "queue": "al-ummah-now-videos-qa"
      },
      // Contact us mail jobs (lib/contact-mail-queue.ts), consumed below
      { "binding": "CONTACT_MAIL_QUEUE", "queue": "al-ummah-now-contact-mail-qa" },
      // Final mail failures → platform DLQ (processor stores them in dead_letters)
      { "binding": "ERRORS_DLQ", "queue": "al-ummah-now-dlq-qa" },
      // Requests to auth: sends, answers and status reads, with retries (src/lib/authModerationQueue.ts)
      { "binding": "AUTH_REQUESTS_QUEUE", "queue": "auth-moderation-requests-qa" },
      {
        // Error ingest (endpoints/errors/ErrorsIngest.ts): /internal/errors enqueues, this Worker writes D1
        "binding": "ERRORS_QUEUE",
        "queue": "al-ummah-now-errors-qa"
      }
    ],
    "consumers": [
      {
        // Retries back off in code (msg.retry delaySeconds); keep max_retries = MAX_ATTEMPTS - 1
        "queue": "al-ummah-now-contact-mail-qa",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "al-ummah-now-dlq-qa"
      },
      { "queue": "auth-moderation-requests-qa", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 6, "retry_delay": 30, "dead_letter_queue": "auth-moderation-requests-dlq-qa" },
      { "queue": "auth-moderation-requests-dlq-qa", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 3 },
      {
        "queue": "al-ummah-now-errors-qa",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "al-ummah-now-errors-dlq-qa"
      },
      {
        // Batches that failed 5 times: retried every 15 minutes, no DLQ of its own
        "queue": "al-ummah-now-errors-dlq-qa",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 10
      }
    ]
  },
  // Every 5 minutes: status reads of open requests to auth; 03:17 UTC: error data retention
  "triggers": { "crons": ["*/5 * * * *", "17 3 * * *"] },
  // Private source maps uploaded by the release (lib/sourcemaps.ts) are in r2_buckets as SOURCEMAPS.
  // VIDEOS: api-videos owns the content data: /internal/* (processing health, content management)
  // PROCESSOR, SCHEDULER: Retry actions on the Errors page (lib/errors-actions.ts): dead letters, failed scheduled publishes
  "services": [
    { "binding": "VIDEOS", "service": "videos-qa" },
    { "binding": "PROCESSOR", "service": "al-ummah-now-processor-qa" },
    { "binding": "SCHEDULER", "service": "al-ummah-scheduler-qa" }
  ],

  "vars": {
    "ENVIRONMENT": "qa",
    "LOG_LEVEL": "debug",
    "WEBSOCKET_URL": "https://realtime.qa.alummahnow.net",
    "Issuer": "https://auth.qa.alummahnow.net",
    // Shown in admin when D1 has no cap; keep equal to the processor's value
    "AI_MODERATION_DAILY_NEURON_CAP": "10000",
    // Contact us (lib/contact-email.ts)
    "CONTACT_INBOX": "support@alummahnow.net",
    // Moderation requests to auth: this app's auth client (secret: worker secret
    // AUTH_MODERATION_CLIENT_SECRET) and the admin web for evidence links
    "AUTH_MODERATION_CLIENT_ID": "d7464de8-363d-4fc1-b1af-7c71653f0afc",
    "ADMIN_WEB_URL": "https://admin.qa.alummahnow.net"
  },

  "secrets_store_secrets": [
    {
      "binding": "INTERNAL_API_KEY",
      "store_id": "f8eddc9944d041919ed8dc7d08d32308",
      "secret_name": "internal-api-key-qa"
    },
    {
      "binding": "RESEND_API_KEY",
      "store_id": "f8eddc9944d041919ed8dc7d08d32308",
      "secret_name": "RESEND_API_KEY"
    }
  ],

  "observability": {

    "enabled": true,

    // Workers Logs bills per line: log 10% of invocations (sampling drops errors too)

    "head_sampling_rate": 0.1,

    "logs": { "enabled": true, "head_sampling_rate": 0.1 }

  },

  "dev": {
    "ip": "127.0.0.1",
    "port": 3090,
    "local_protocol": "http"
  }
}
