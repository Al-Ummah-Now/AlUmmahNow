{
  "name": "@al-ummah/media",
  "version": "1.0.0",
  "private": true,
  "description": "R2 video delivery beside Bunny: FFmpeg transcodes on Cloudflare Containers, private-rendition edge (epic #687)",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --config wrangler.qa.jsonc",
    "deploy:qa": "wrangler deploy --config wrangler.qa.jsonc",
