  "dependencies": {
    "@al-ummah/shared-types": "workspace:*",
    "@cloudflare/containers": "0.3.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251106.1",
    "@eslint/js": "^9.39.1",
    "@types/node": "^20.0.0",
    "eslint": "9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "wrangler": "^4.108.0"
  }
}
