{
	"$schema": "node_modules/wrangler/config-schema.json",
	// R2 video delivery beside Bunny (epic #687, docs/media-delivery/R2-DELIVERY-PLAN.md).
	// Production at the top level, stage under env.stage (same bindings, stage resources).
	// QA: wrangler.qa.jsonc. Released by release.yml with `wrangler deploy` (Containers do not
	// take versions upload), after the other apps' promote and its smoke.
	"name": "al-ummah-now-media",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-01",
	"compatibility_flags": ["nodejs_compat", "enable_ctx_exports"],
	"workers_dev": false,
	"preview_urls": false,
	// Logging policy (docs/operations/logging.md): this worker logs warn/error only
	"observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false } },
	// Private renditions (/priv/*) and Web Download attachment helper (/dl/*) run this Worker; /pub/* is the R2 custom domain + Cache Rule
	"routes": [
		{ "pattern": "media.alummahnow.net/priv/*", "zone_name": "alummahnow.net" },
		{ "pattern": "media.alummahnow.net/dl/*", "zone_name": "alummahnow.net" }
	],
	"containers": [
		{
			"class_name": "Transcoder",
			"image": "./container/Dockerfile",
			"image_build_context": "./container",
			"instance_type": "standard-4",
			// Cloudflare's own limit, not one of ours: Containers have no per-application cap, only account-wide
			// concurrency (15,000 vCPU, 60 TiB memory, 300 TB disk; https://developers.cloudflare.com/containers/platform-details/limits/#account-limits),
			// and vCPU binds first. The quota (GET /accounts/{id}/containers/me → limits.total_vcpu 15000) is
			// shared by every application on the account, other projects included: each reserves max_instances
			// x its vCPU and a deploy is refused past it (v2026.11.15.3 at 3,750). 10% stays free for the other
			// projects; stage and QA hold 16; on 2026-11-16 no other project had a container. So production is
			// (15,000 x 0.9 - 16) / 4 vCPU per standard-4 = 3,371. scripts/release/container-quota.ts checks the
			// whole account before every release.
			// The admin's min–max range (Video providers → Cloudflare R2 settings, enforced by TranscodeSlots)
			// decides how many run. Instances that are not running cost nothing.
			"max_instances": 3371,
			// A deploy lets running transcodes finish (up to 1 h) before their instance is replaced;
			// one cut off after that retries at once without using up an attempt (jobs.ts isInfraFailure)
			"rollout_active_grace_period": 3600
		}
	],
	"durable_objects": {
		"bindings": [
			{ "name": "TRANSCODER", "class_name": "Transcoder" },
			// One object: the slots that enforce the admin's max concurrent transcodes (src/slot-state.ts)
			{ "name": "TRANSCODE_SLOTS", "class_name": "TranscodeSlots" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["Transcoder"] },
		{ "tag": "v2", "new_sqlite_classes": ["TranscodeSlots"] }
	],
	// MEDIA: public renditions (pub/…), served by the R2 custom domain. MEDIA_PRIVATE: private and
	// unlisted ones (priv/…), with no public access at all: only /priv/ (token checked) reads it.
	"r2_buckets": [
		{ "binding": "MEDIA", "bucket_name": "al-ummah-now-media" },
		{ "binding": "MEDIA_PRIVATE", "bucket_name": "al-ummah-now-media-private" },
		// Uploads as received (read only): the transcode source (docs/media-delivery/ORIGINALS.md)
		{ "binding": "MEDIA_ORIGINALS", "bucket_name": "al-ummah-now-media-originals" },
		// Read only here: the admin's max concurrent transcodes (ops/media-transcode-limit.json, written by api-videos)
		{ "binding": "GLOBAL_SETTINGS", "bucket_name": "global-settings" }
	],
	"services": [{ "binding": "VIDEOS", "service": "videos" }],
	"queues": {
		// A job with no free slot is sent again later (src/dispatch.ts)
		"producers": [{ "binding": "TRANSCODE_QUEUE", "queue": "al-ummah-now-transcode" }],
		"consumers": [
			{
				"queue": "al-ummah-now-transcode",
				"max_batch_size": 1,
				"max_batch_timeout": 5,
				"max_concurrency": 10,
				"max_retries": 8,
				"dead_letter_queue": "al-ummah-now-transcode-dlq"
			}
		]
	},
	"secrets_store_secrets": [
		{ "binding": "MEDIA_SIGN_KEY", "store_id": "f8eddc9944d041919ed8dc7d08d32308", "secret_name": "media-sign-key" },
		{ "binding": "INTERNAL_API_KEY", "store_id": "f8eddc9944d041919ed8dc7d08d32308", "secret_name": "internal-api-key" }
	],
	// The deployed version: the release self-test runs a few real starts per version, not per call
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	// MEDIA_TRANSCODE_CEILING: max_instances above (the admin's setting can't go higher)
	"vars": { "TRANSCODER_INSTANCE": "standard-4", "LOG_LEVEL": "warn", "MEDIA_TRANSCODE_CEILING": "3371" },

	"env": {
		"stage": {
			"name": "al-ummah-now-media-stage",
			"workers_dev": false,
			"preview_urls": false,
			"observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false } },
			"routes": [
				{ "pattern": "media.stage.alummahnow.net/priv/*", "zone_name": "alummahnow.net" },
				{ "pattern": "media.stage.alummahnow.net/dl/*", "zone_name": "alummahnow.net" }
			],
			"containers": [
				{
					"class_name": "Transcoder",
					"image": "./container/Dockerfile",
					"image_build_context": "./container",
					"instance_type": "standard-4",
					// Kept small: Cloudflare's account-wide limit is shared with production (see the top level)
					"max_instances": 2,
					// A deploy lets running transcodes finish (up to 1 h) before their instance is replaced;
					// one cut off after that retries at once without using up an attempt (jobs.ts isInfraFailure)
					"rollout_active_grace_period": 3600
				}
			],
			"durable_objects": {
				"bindings": [
					{ "name": "TRANSCODER", "class_name": "Transcoder" },
					{ "name": "TRANSCODE_SLOTS", "class_name": "TranscodeSlots" }
				]
			},
			"migrations": [
				{ "tag": "v1", "new_sqlite_classes": ["Transcoder"] },
				{ "tag": "v2", "new_sqlite_classes": ["TranscodeSlots"] }
			],
			"r2_buckets": [
				{ "binding": "MEDIA", "bucket_name": "al-ummah-now-media-stage" },
				{ "binding": "MEDIA_PRIVATE", "bucket_name": "al-ummah-now-media-private-stage" },
				{ "binding": "MEDIA_ORIGINALS", "bucket_name": "al-ummah-now-media-originals-stage" },
				{ "binding": "GLOBAL_SETTINGS", "bucket_name": "global-settings-stage" }
			],
			"services": [{ "binding": "VIDEOS", "service": "videos-stage" }],
			"queues": {
				"producers": [{ "binding": "TRANSCODE_QUEUE", "queue": "al-ummah-now-transcode-stage" }],
				"consumers": [
					{
						"queue": "al-ummah-now-transcode-stage",
						"max_batch_size": 1,
						"max_batch_timeout": 5,
						"max_concurrency": 2,
						"max_retries": 8,
						"dead_letter_queue": "al-ummah-now-transcode-dlq-stage"
					}
				]
			},
			"secrets_store_secrets": [
				{ "binding": "MEDIA_SIGN_KEY", "store_id": "f8eddc9944d041919ed8dc7d08d32308", "secret_name": "media-sign-key-stage" },
				{ "binding": "INTERNAL_API_KEY", "store_id": "f8eddc9944d041919ed8dc7d08d32308", "secret_name": "internal-api-key-stage" }
			],
			// The deployed version: the release self-test runs a few real starts per version, not per call
			"version_metadata": { "binding": "CF_VERSION_METADATA" },
			"vars": { "TRANSCODER_INSTANCE": "standard-4", "LOG_LEVEL": "warn", "MEDIA_TRANSCODE_CEILING": "2" }
		}
	}
}
