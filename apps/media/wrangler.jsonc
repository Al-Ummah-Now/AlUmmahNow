{
	"$schema": "node_modules/wrangler/config-schema.json",
	// R2 video delivery beside Bunny (epic #687, docs/media-delivery/R2-DELIVERY-PLAN.md).
	// Production at the top level, stage under env.stage (same bindings, stage resources).
	// QA: wrangler.qa.jsonc. Released by release.yml with `wrangler deploy` (Containers do not
	// take versions upload), after the other apps' promote and its smoke.
	"name": "al-ummah-now-media",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-01",
	"compatibility_flags": ["nodejs_compat", "enable_ctx_exports"],
	"workers_dev": false,
	// Logging policy (docs/operations/logging.md): this worker logs warn/error only
	"observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false } },
	// Only private renditions run this Worker; /pub/* is the R2 custom domain + Cache Rule
	"routes": [{ "pattern": "media.alummahnow.net/priv/*", "zone_name": "alummahnow.net" }],
	"containers": [
		{
			"class_name": "Transcoder",
			"image": "./container/Dockerfile",
			"image_build_context": "./container",
			"instance_type": "standard-4",
			// Bounds spend: at most this many transcodes at once (the queue backs off when full)
			"max_instances": 4
		}
	],
	"durable_objects": { "bindings": [{ "name": "TRANSCODER", "class_name": "Transcoder" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Transcoder"] }],
	// MEDIA: public renditions (pub/…), served by the R2 custom domain. MEDIA_PRIVATE: private and
	// unlisted ones (priv/…), with no public access at all: only /priv/ (token checked) reads it.
	"r2_buckets": [
		{ "binding": "MEDIA", "bucket_name": "al-ummah-now-media" },
		{ "binding": "MEDIA_PRIVATE", "bucket_name": "al-ummah-now-media-private" },
		// Uploads as received (read only): the transcode source (docs/media-delivery/ORIGINALS.md)
		{ "binding": "MEDIA_ORIGINALS", "bucket_name": "al-ummah-now-media-originals" }
	],
	"services": [{ "binding": "VIDEOS", "service": "videos" }],
	"queues": {
		"consumers": [
			{
				"queue": "al-ummah-now-transcode",
				"max_batch_size": 1,
				"max_batch_timeout": 5,
				"max_concurrency": 4,
				"max_retries": 8,
				"dead_letter_queue": "al-ummah-now-transcode-dlq"
			}
		]
	},
	"secrets_store_secrets": [
		{ "binding": "MEDIA_SIGN_KEY", "store_id": "f8eddc9944d041919ed8dc7d08d32308", "secret_name": "media-sign-key" },
		{ "binding": "INTERNAL_API_KEY", "store_id": "f8eddc9944d041919ed8dc7d08d32308", "secret_name": "internal-api-key" }
	],
	"vars": { "TRANSCODER_INSTANCE": "standard-4", "LOG_LEVEL": "warn" },

	"env": {
		"stage": {
			"name": "al-ummah-now-media-stage",
			"workers_dev": false,
			"observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false } },
			"routes": [{ "pattern": "media.stage.alummahnow.net/priv/*", "zone_name": "alummahnow.net" }],
			"containers": [
				{
					"class_name": "Transcoder",
					"image": "./container/Dockerfile",
					"image_build_context": "./container",
					"instance_type": "standard-4",
					"max_instances": 2
				}
			],
			"durable_objects": { "bindings": [{ "name": "TRANSCODER", "class_name": "Transcoder" }] },
			"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Transcoder"] }],
			"r2_buckets": [
				{ "binding": "MEDIA", "bucket_name": "al-ummah-now-media-stage" },
				{ "binding": "MEDIA_PRIVATE", "bucket_name": "al-ummah-now-media-private-stage" },
				{ "binding": "MEDIA_ORIGINALS", "bucket_name": "al-ummah-now-media-originals-stage" }
			],
			"services": [{ "binding": "VIDEOS", "service": "videos-stage" }],
			"queues": {
				"consumers": [
					{
						"queue": "al-ummah-now-transcode-stage",
						"max_batch_size": 1,
						"max_batch_timeout": 5,
						"max_concurrency": 2,
						"max_retries": 8,
						"dead_letter_queue": "al-ummah-now-transcode-dlq-stage"
					}
				]
			},
			"secrets_store_secrets": [
				{ "binding": "MEDIA_SIGN_KEY", "store_id": "f8eddc9944d041919ed8dc7d08d32308", "secret_name": "media-sign-key-stage" },
				{ "binding": "INTERNAL_API_KEY", "store_id": "f8eddc9944d041919ed8dc7d08d32308", "secret_name": "internal-api-key-stage" }
			],
			"vars": { "TRANSCODER_INSTANCE": "standard-4", "LOG_LEVEL": "warn" }
		}
	}
}
