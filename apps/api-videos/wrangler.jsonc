/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "videos",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-12",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	// Daily GDPR retention sweep (src/lib/privacy/retention.ts)
	"triggers": {
		"crons": ["17 3 * * *", "47 * * * *", "*/10 * * * *"]
	},
	"observability": {
		"enabled": true,
		// Logging policy (docs/operations/logging.md): every invocation is sampled, so
		// every warn/error line is kept (head sampling is decided before the outcome is
		// known, so a lower rate would drop errors too). The code logs only warn/error and
		// slow requests in production; the automatic per-invocation log line is off on
		// this high-volume worker (the request/job summaries replace it).
		"head_sampling_rate": 1,
		"logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false }
	},
	/**
	 * Smart Placement
	 * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": { "mode": "smart" },
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	// Per-video view counter (realtime worker, apps/websocket-server/src/view-counter.ts). Cross-script binding: the class lives in the comms worker of the same environment.
	"durable_objects": {
		"bindings": [
			{ "name": "VIEW_COUNTER", "class_name": "WebSocketDurableObject", "script_name": "al-ummah-now-comms" }
		]
	},
	"r2_buckets": [
		{
			"binding": "videos",
			"bucket_name": "videos",
			"preview_bucket_name": "videos-preview",
			"remote": true
		},
		{
			"binding": "profiles",
			"bucket_name": "profiles",
			"preview_bucket_name": "profiles-preview",
			"remote": true
		},
		{
			"binding": "channels",
			"bucket_name": "channels",
			"preview_bucket_name": "channels-preview",
			"remote": true
		},
		{
			"binding": "playlists",
			"bucket_name": "playlists",
			"preview_bucket_name": "playlists-preview",
			"remote": true
		},
		{
			"binding": "reports",
			"bucket_name": "reports",
			"preview_bucket_name": "reports-preview",
			"remote": true
		},
		{
			"binding": "watch_history",
			"bucket_name": "watch-history",
			"preview_bucket_name": "watch-history-preview",
			"remote": true
		},
		{
			"binding": "channel_sections",
			"bucket_name": "channel-sections",
			"preview_bucket_name": "channel-sections-preview",
			"remote": true
		},
		{
			"binding": "community_posts",
			"bucket_name": "community-posts",
			"preview_bucket_name": "community-posts-preview",
			"remote": true
		},
		{
			"binding": "channel_tabs",
			"bucket_name": "channel-tabs",
			"preview_bucket_name": "channel-tabs-preview",
			"remote": true
		},
		{
			"binding": "upload-defaults",
			"bucket_name": "upload-defaults",
			"preview_bucket_name": "upload-defaults-preview",
			"remote": true
		},
		{
			"binding": "subtitles",
			"bucket_name": "subtitles",
			"preview_bucket_name": "subtitles-preview",
			"remote": true
		},
		{
			"binding": "SCHEDULED_VIDEOS",
			"bucket_name": "scheduled-videos",
			"preview_bucket_name": "scheduled-videos-preview",
			"remote": true
		},
		{
			"binding": "scheduled-videos",
			"bucket_name": "scheduled-videos",
			"preview_bucket_name": "scheduled-videos-preview",
			"remote": true
		},
		{
			"binding": "global_settings",
			"bucket_name": "global-settings",
			"preview_bucket_name": "global-settings-preview",
			"remote": true
		},
		{
			// Read-only use: daily view/watch-time rollups written by the processor
			// (analytics/rollups/*) in the processor's messages bucket
			"binding": "analytics_rollups",
			"bucket_name": "al-ummah-now-messages",
			"remote": true
		},
		{
			// Private pre-change copies written by admin jobs (legacy profile restore); never public
			"binding": "ADMIN_BACKUPS",
			"bucket_name": "admin-backups"
		},
		// R2 delivery beside Bunny (epic #687): renditions written by apps/media; api-videos
		// moves them on visibility changes and deletes them at purge
		{ "binding": "MEDIA", "bucket_name": "al-ummah-now-media" },
		{ "binding": "MEDIA_PRIVATE", "bucket_name": "al-ummah-now-media-private" },
		// Uploads as received, for the R2 transcode (docs/media-delivery/ORIGINALS.md)
		{ "binding": "MEDIA_ORIGINALS", "bucket_name": "al-ummah-now-media-originals" }
	],
	"d1_databases": [
		{
			// Notification center + library indexes (Epic 29); migrations live in apps/processor.
			"binding": "NOTIFICATIONS_DB",
			"database_name": "al-ummah-now-notifications",
			"database_id": "2479ad9b-76f6-41e6-ac77-69e46faa5e69"
		},
		{
			// Search index (Epic 29, Story 29.9). Schema: migrations/search.
			// After deploy, fill it with scripts/search-backfill.sh until it reports complete (#216).
			"binding": "SEARCH_DB",
			"database_name": "al-ummah-now-search",
			"database_id": "41064871-cf1f-46e9-b102-7b913240ad89",
			"migrations_dir": "migrations/search"
		},
		{
			// Auth service D1, READ ONLY: the legacy profile restore (lib/admin/legacy-restore.ts)
			// reads users.email (the verified address). Nothing here writes to it.
			"binding": "AUTH_DB",
			"database_name": "al-ummah-now-d1",
			"database_id": "af76f007-e21e-43aa-88de-ebfefe46fb56"
		}
	],
	// Watch-time reports per playback session (#235); videoWatchTime.ts
	"ratelimits": [
		{ "name": "WATCH_TIME_LIMITER", "namespace_id": "2201", "simple": { "limit": 6, "period": 60 } },
		// Typeahead lookups per user or IP (GET /api/search/suggestions)
		{ "name": "SUGGEST_LIMITER", "namespace_id": "2221", "simple": { "limit": 120, "period": 60 } }
	],
	"kv_namespaces": [
			// Token revocation list written by the auth worker (#437)
			{ "binding": "TOKEN_REVOCATIONS", "id": "2afbb5f5d5414c9ea1a7d54013cfe724", "preview_id": "e6e662fc9cd9420797ddfa8060eb6956" },
		{
			"binding": "TUS_SESSIONS",
			"id": "a7f78b8bf0984994a2cd2f4c92169ae1",
			"preview_id": "56c4fbe8aec04166b9256bf951655c3a",
			"remote": true
		}
	],
	"queues": {
		// Per-video processing-check loop (src/lib/processing/loop.ts): the consumer
		// re-enqueues a video with a delay until Bunny finishes encoding it.
		"consumers": [
			{
				"queue": "al-ummah-now-processing-check",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 5,
				"dead_letter_queue": "al-ummah-now-dlq"
			},
			{
				// Heavy admin actions (lib/admin/jobs.ts). One job per invocation: each gets the full subrequest budget.
				"queue": "al-ummah-now-admin-jobs",
				"max_batch_size": 1,
				"max_batch_timeout": 5,
				"max_retries": 5,
				"dead_letter_queue": "al-ummah-now-dlq"
			}
		],
		"producers": [
			{
				"queue": "al-ummah-now-processing-check",
				"binding": "PROCESSING_CHECK_QUEUE"
			},
			{
				"queue": "al-ummah-now-videos",
				"binding": "queue"
			},
			{
				"queue": "al-ummah-now-moderation",
				"binding": "MODERATION_QUEUE"
			},
			{
				"queue": "al-ummah-now-admin-jobs",
				"binding": "ADMIN_JOBS_QUEUE"
			},
			{
				// R2 transcodes (apps/media consumes)
				"queue": "al-ummah-now-transcode",
				"binding": "TRANSCODE_QUEUE"
			}
		]
	},
	"secrets_store_secrets": [
	  {
		"binding": "image_storage_key",
		"store_id": "f8eddc9944d041919ed8dc7d08d32308",
		"secret_name": "al-ummah-now-images-key"
	  },
	  {
		// Primary Bunny Stream library 498994 ("al-ummah-now", vz-25839d05): every new upload
		"binding": "bunny-stream-key",
		"store_id": "f8eddc9944d041919ed8dc7d08d32308",
		"secret_name": "bunny-stream-key-498994"
	  },
	  {
		"binding": "bunny_stream_library_id",
		"store_id": "f8eddc9944d041919ed8dc7d08d32308",
		"secret_name": "bunny-stream-library-id-498994"
	  },
	  {
		"binding": "INTERNAL_API_KEY",
		"store_id": "f8eddc9944d041919ed8dc7d08d32308",
		"secret_name": "internal-api-key"
	  },
	  {
		// Bunny CDN token authentication key of library 498994 (vz-25839d05)
		"binding": "BUNNY_TOKEN_KEY",
		"store_id": "f8eddc9944d041919ed8dc7d08d32308",
		"secret_name": "bunny-stream-token-key-498994"
	  },
	  {
		// Legacy library 400189 (vz-215a1ffd): the videos already there keep
		// playing, processing and deleting through its own API key and token key
		"binding": "BUNNY_LEGACY_STREAM_KEY",
		"store_id": "f8eddc9944d041919ed8dc7d08d32308",
		"secret_name": "bunny-stream-key"
	  },
	  {
		"binding": "BUNNY_LEGACY_TOKEN_KEY",
		"store_id": "f8eddc9944d041919ed8dc7d08d32308",
		"secret_name": "bunny-stream-token-key"
	  },
	  {
		// Path tokens of private R2 renditions (shared with apps/media)
		"binding": "MEDIA_SIGN_KEY",
		"store_id": "f8eddc9944d041919ed8dc7d08d32308",
		"secret_name": "media-sign-key"
	  },
	  {
	  	// Cloudflare token (Secrets Store media-cdn-api-token): CDN purge when a video turns private; R2 and media-host analytics for the daily costs
	  	"binding": "MEDIA_CDN_API_TOKEN",
	  	"store_id": "f8eddc9944d041919ed8dc7d08d32308",
	  	"secret_name": "media-cdn-api-token"
	  },
	  {
	  	"binding": "MEDIA_ANALYTICS_TOKEN",
	  	"store_id": "f8eddc9944d041919ed8dc7d08d32308",
	  	"secret_name": "media-cdn-api-token"
	  }
	],
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 */
	// "vars": { "MY_VARIABLE": "production_value" },
	"vars": {
		// Error reports to the admin Errors page (docs/features/error-reporting.md)
		"ERRORS_INGEST_URL": "https://admin.api.alummahnow.net/internal/errors",
		// R2 delivery host (public renditions direct from R2, private ones via apps/media). The
		// viewer switch (admin Delivery page) defaults to Bunny; uploads are dual-written to R2.
		"MEDIA_PUBLIC_HOST": "media.alummahnow.net",
		"MEDIA_BUCKET_NAMES": "al-ummah-now-media,al-ummah-now-media-private,al-ummah-now-media-originals",
		// Kept originals: at least this many days, and until the R2 rendition is ready; never past the ceiling
		"ORIGINALS_RETENTION_DAYS": "30",
		"ORIGINALS_MAX_DAYS": "90",
		// Max concurrent transcodes: max_instances of the transcoder container (apps/media/wrangler.jsonc); the Delivery page shows "N of M"
		"MEDIA_MAX_TRANSCODES": "4",
		// Logging policy (docs/operations/logging.md): production warn, stage info, QA/dev debug
		"LOG_LEVEL": "warn",
		"ENVIRONMENT": "production",
		"ZONE": "al-ummah-now-images",
		"ClientId": "b1770235-e4b6-42f3-9eb4-3c03ca111b02",
		"Issuer": "https://auth.alummahnow.net",
		"Audience": "https://videos.api.alummahnow.net",
		// CDN host of the primary library (498994), the one the stream
		// key/library-id secrets point at. New uploads land there, so their
		// playUrl must use this host: a host of another library 404s every new
		// upload (2026-11-10 incident). lib/bunny/libraries.ts
		"bunny_hostname": "vz-25839d05-80d.b-cdn.net",
		// Legacy library 400189: the videos uploaded before the switch stay there
		// (their records name it by bunnyLibraryId or their playUrl host)
		"BUNNY_LEGACY_LIBRARY_ID": "400189",
		"BUNNY_LEGACY_HOSTNAME": "vz-215a1ffd-a5a.b-cdn.net",
		// Both libraries have CDN token auth on: sign their URLs (playUrl,
		// thumbnails) in API responses, each with its own token key
		"BUNNY_SIGN_URLS": "true",
		// Name prefix for Bunny videos/collections this env creates (stage: "[stage] "; none in production)
		"BUNNY_NAME_PREFIX": "",
		// Test-library purge off: production's library is real (the purge also refuses ENVIRONMENT=production)
		"BUNNY_TEST_LIBRARY": "false",
		// Upload limits enforced (any value but "off"): the numbers come from each user's creator tier, edited in the videos admin (middleware/upload-limits.ts)
		"UPLOAD_RATE_LIMIT": "standard",
		"WEBSOCKET_URL": "https://realtime.alummahnow.net",
		"CORS_ORIGINS": "https://videos.alummahnow.net,https://alummahnow.net,https://www.alummahnow.net,https://admin.alummahnow.net,https://cms.alummahnow.net"
	},
	/**
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": { "directory": "./public/", "binding": "ASSETS" },
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [{ "binding": "MY_SERVICE", "service": "my-service" }]
	"dev": {
		"ip": "127.0.0.1",
		"port": 3086,
		"local_protocol": "http"
	},
	"env": {
		// Stage slot (docs/release-pipeline): same bindings as production, stage resources and hosts.
		"stage": {
			// Workers Logs bills per line: log 10% of invocations (sampling drops errors too)
			"observability": { "enabled": true, "head_sampling_rate": 0.1, "logs": { "enabled": true, "head_sampling_rate": 0.1 } },
			"version_metadata": { "binding": "CF_VERSION_METADATA" },
			"name": "videos-stage",
			"routes": [
				{
					"pattern": "videos.api.stage.alummahnow.net",
					"custom_domain": true
				}
			],
			"durable_objects": {
				"bindings": [
					{ "name": "VIEW_COUNTER", "class_name": "WebSocketDurableObject", "script_name": "al-ummah-now-comms-stage" }
				]
			},
			"r2_buckets": [
				{
					"binding": "videos",
					"bucket_name": "videos-stage"
				},
				{
					"binding": "profiles",
					"bucket_name": "profiles-stage"
				},
				{
					"binding": "channels",
					"bucket_name": "channels-stage"
				},
				{
					"binding": "playlists",
					"bucket_name": "playlists-stage"
				},
				{
					"binding": "reports",
					"bucket_name": "reports-stage"
				},
				{
					"binding": "watch_history",
					"bucket_name": "watch-history-stage"
				},
				{
					"binding": "channel_sections",
					"bucket_name": "channel-sections-stage"
				},
				{
					"binding": "community_posts",
					"bucket_name": "community-posts-stage"
				},
				{
					"binding": "channel_tabs",
					"bucket_name": "channel-tabs-stage"
				},
				{
					"binding": "upload-defaults",
					"bucket_name": "upload-defaults-stage"
				},
				{
					"binding": "subtitles",
					"bucket_name": "subtitles-stage"
				},
				{
					"binding": "SCHEDULED_VIDEOS",
					"bucket_name": "scheduled-videos-stage"
				},
				{
					"binding": "scheduled-videos",
					"bucket_name": "scheduled-videos-stage"
				},
				{
					"binding": "global_settings",
					"bucket_name": "global-settings-stage"
				},
				{
					"binding": "analytics_rollups",
					"bucket_name": "al-ummah-now-messages-stage"
				},
				{
					"binding": "ADMIN_BACKUPS",
					"bucket_name": "admin-backups-stage"
				},
				{ "binding": "MEDIA", "bucket_name": "al-ummah-now-media-stage" },
				{ "binding": "MEDIA_PRIVATE", "bucket_name": "al-ummah-now-media-private-stage" },
				{ "binding": "MEDIA_ORIGINALS", "bucket_name": "al-ummah-now-media-originals-stage" }
			],
			"d1_databases": [
				{
					"binding": "NOTIFICATIONS_DB",
					"database_name": "al-ummah-now-notifications-stage",
					"database_id": "8626a5a5-0291-4150-ac9e-6083b606a140"
				},
				{
					"binding": "SEARCH_DB",
					"database_name": "al-ummah-now-search-stage",
					"database_id": "956a3550-bd20-4cfc-9bf2-b1c2265b33dd",
					"migrations_dir": "migrations/search"
				},
				{
					// Auth service D1 (stage), READ ONLY: legacy profile restore
					"binding": "AUTH_DB",
					"database_name": "al-ummah-now-d1-stage",
					"database_id": "c7886ef6-c70b-4b7f-a65b-3df9f9aba9e2"
				}
			],
			// Watch-time reports per playback session (#235); videoWatchTime.ts
			"ratelimits": [
				{ "name": "WATCH_TIME_LIMITER", "namespace_id": "2202", "simple": { "limit": 6, "period": 60 } },
				// Typeahead lookups per user or IP (GET /api/search/suggestions)
				{ "name": "SUGGEST_LIMITER", "namespace_id": "2222", "simple": { "limit": 120, "period": 60 } }
			],
			"kv_namespaces": [
			// Token revocation list written by the auth worker (#437)
			{ "binding": "TOKEN_REVOCATIONS", "id": "0831520b71144a6e848ed62918602c13" },
				{
					"binding": "TUS_SESSIONS",
					"id": "a200f6a898594502971558727243e538"
				}
			],
			"queues": {
				"consumers": [
					{
						"queue": "al-ummah-now-processing-check-stage",
						"max_batch_size": 10,
						"max_batch_timeout": 5,
						"max_retries": 5,
						"dead_letter_queue": "al-ummah-now-dlq-stage"
					},
					{
						// Heavy admin actions (lib/admin/jobs.ts). One job per invocation: each gets the full subrequest budget.
						"queue": "al-ummah-now-admin-jobs-stage",
						"max_batch_size": 1,
						"max_batch_timeout": 5,
						"max_retries": 5,
						"dead_letter_queue": "al-ummah-now-dlq-stage"
					}
				],
				"producers": [
					{
						"queue": "al-ummah-now-processing-check-stage",
						"binding": "PROCESSING_CHECK_QUEUE"
					},
					{
						"queue": "al-ummah-now-videos-stage",
						"binding": "queue"
					},
					{
						"queue": "al-ummah-now-moderation-stage",
						"binding": "MODERATION_QUEUE"
					},
					{
						"queue": "al-ummah-now-admin-jobs-stage",
						"binding": "ADMIN_JOBS_QUEUE"
					},
					{
						"queue": "al-ummah-now-transcode-stage",
						"binding": "TRANSCODE_QUEUE"
					}
				]
			},
			"secrets_store_secrets": [
				{
					"binding": "image_storage_key",
					"store_id": "f8eddc9944d041919ed8dc7d08d32308",
					"secret_name": "al-ummah-now-images-key"
				},
				{
					"binding": "bunny-stream-key",
					"store_id": "f8eddc9944d041919ed8dc7d08d32308",
					"secret_name": "bunny-stream-key-qa"
				},
				{
					"binding": "bunny_stream_library_id",
					"store_id": "f8eddc9944d041919ed8dc7d08d32308",
					"secret_name": "bunny-stream-library-id-qa"
				},
				{
					"binding": "INTERNAL_API_KEY",
					"store_id": "f8eddc9944d041919ed8dc7d08d32308",
					"secret_name": "internal-api-key-stage"
				},
				{
					"binding": "BUNNY_TOKEN_KEY",
					"store_id": "f8eddc9944d041919ed8dc7d08d32308",
					"secret_name": "bunny-stream-token-key-qa"
				},
				{
					"binding": "MEDIA_SIGN_KEY",
					"store_id": "f8eddc9944d041919ed8dc7d08d32308",
					"secret_name": "media-sign-key-stage"
				},
				{
					// Cloudflare token (Secrets Store media-cdn-api-token): CDN purge when a video turns private; R2 and media-host analytics for the daily costs
					"binding": "MEDIA_CDN_API_TOKEN",
					"store_id": "f8eddc9944d041919ed8dc7d08d32308",
					"secret_name": "media-cdn-api-token"
				},
				{
					"binding": "MEDIA_ANALYTICS_TOKEN",
					"store_id": "f8eddc9944d041919ed8dc7d08d32308",
					"secret_name": "media-cdn-api-token"
				},
				{
					// Production parity only: unused while BUNNY_LEGACY_LIBRARY_ID is empty (stage has no legacy library)
					"binding": "BUNNY_LEGACY_STREAM_KEY",
					"store_id": "f8eddc9944d041919ed8dc7d08d32308",
					"secret_name": "bunny-stream-key-qa"
				},
				{
