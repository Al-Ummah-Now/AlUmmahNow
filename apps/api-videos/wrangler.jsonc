/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "videos",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-12",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	/**
	 * Smart Placement
	 * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": { "mode": "smart" },
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	"r2_buckets": [
		{
			"binding": "videos",
			"bucket_name": "videos",
			"preview_bucket_name": "videos-preview",
			"remote": true
		},
		{
			"binding": "profiles",
			"bucket_name": "profiles",
			"preview_bucket_name": "profiles-preview",
			"remote": true
		},
		{
			"binding": "channels",
			"bucket_name": "channels",
			"preview_bucket_name": "channels-preview",
			"remote": true
		},
		{
			"binding": "playlists",
			"bucket_name": "playlists",
			"preview_bucket_name": "playlists-preview",
			"remote": true
		},
		{
			"binding": "reports",
			"bucket_name": "reports",
			"preview_bucket_name": "reports-preview",
			"remote": true
		},
		{
			"binding": "watch_history",
			"bucket_name": "watch-history",
			"preview_bucket_name": "watch-history-preview",
			"remote": true
		},
		{
			"binding": "channel_sections",
			"bucket_name": "channel-sections",
			"preview_bucket_name": "channel-sections-preview",
			"remote": true
		},
		{
			"binding": "community_posts",
			"bucket_name": "community-posts",
			"preview_bucket_name": "community-posts-preview",
			"remote": true
		},
		{
			"binding": "channel_tabs",
			"bucket_name": "channel-tabs",
			"preview_bucket_name": "channel-tabs-preview",
			"remote": true
		}
	],
	"kv_namespaces": [
		{
			"binding": "AUTH_STORAGE",
			"id": "ff057deb522f4b2bb81006b42462f20e",
			"preview_id": "966e04e43b904ddeb26453291bf6c22d"
		},
		{
			"binding": "RATE_LIMIT_KV",
			"id": "PLACEHOLDER_RATE_LIMIT_KV_ID",
			"preview_id": "PLACEHOLDER_RATE_LIMIT_KV_PREVIEW_ID"
		}
	],
	"queues": {
		"consumers": [],
		"producers": [
			{
				"queue": "al-ummah-now-videos",
				"binding": "queue"
			}
		]
	},
	"secrets_store_secrets": [
	  {
		"binding": "image_storage_key",
		"store_id": "f8eddc9944d041919ed8dc7d08d32308",
		"secret_name": "al-ummah-now-images-key"
	  },
	  {
		"binding": "bunny-stream-key",
		"store_id": "f8eddc9944d041919ed8dc7d08d32308",
		"secret_name": "bunny-stream-key"
	  },
	  {
		"binding": "bunny_stream_library_id",
		"store_id": "f8eddc9944d041919ed8dc7d08d32308",
		"secret_name": "bunny_stream_library_id"
	  }
	],
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 */
	// "vars": { "MY_VARIABLE": "production_value" },
	"vars": {
		"ZONE": "al-ummah-now-images",
		"ClientId": "3f2504e0-4f89-11d3-9a0c-0305e82c3301",
		"Issuer": "https://auth.alummahnow.net",
		"Audience": "https://videos.alummahnow.net"
	},
	/**
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": { "directory": "./public/", "binding": "ASSETS" },
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [{ "binding": "MY_SERVICE", "service": "my-service" }]
	"dev": {
		"ip": "127.0.0.1",
		"port": 3086,
		"local_protocol": "http"
	}
}