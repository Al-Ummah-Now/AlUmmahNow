/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "videos",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-12",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	// Daily GDPR retention sweep (src/lib/privacy/retention.ts)
	"triggers": {
		"crons": ["17 3 * * *"]
	},
	"observability": {
		"enabled": true,
		// Low traffic: keep every invocation. Lower this when traffic grows.
		"head_sampling_rate": 1,
		"logs": { "enabled": true, "head_sampling_rate": 1 }
	},
	/**
	 * Smart Placement
	 * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": { "mode": "smart" },
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	"r2_buckets": [
		{
			"binding": "videos",
			"bucket_name": "videos",
			"preview_bucket_name": "videos-preview",
			"remote": true
		},
		{
			"binding": "profiles",
			"bucket_name": "profiles",
			"preview_bucket_name": "profiles-preview",
			"remote": true
		},
		{
			"binding": "channels",
			"bucket_name": "channels",
			"preview_bucket_name": "channels-preview",
			"remote": true
		},
		{
			"binding": "playlists",
			"bucket_name": "playlists",
			"preview_bucket_name": "playlists-preview",
			"remote": true
		},
		{
			"binding": "reports",
			"bucket_name": "reports",
			"preview_bucket_name": "reports-preview",
			"remote": true
		},
		{
			"binding": "watch_history",
			"bucket_name": "watch-history",
			"preview_bucket_name": "watch-history-preview",
			"remote": true
		},
		{
			"binding": "channel_sections",
			"bucket_name": "channel-sections",
			"preview_bucket_name": "channel-sections-preview",
			"remote": true
		},
		{
			"binding": "community_posts",
			"bucket_name": "community-posts",
			"preview_bucket_name": "community-posts-preview",
			"remote": true
		},
		{
			"binding": "channel_tabs",
			"bucket_name": "channel-tabs",
			"preview_bucket_name": "channel-tabs-preview",
			"remote": true
		},
		{
			"binding": "upload-defaults",
			"bucket_name": "upload-defaults",
			"preview_bucket_name": "upload-defaults-preview",
			"remote": true
		},
		{
			"binding": "subtitles",
			"bucket_name": "subtitles",
			"preview_bucket_name": "subtitles-preview",
			"remote": true
		},
		{
			"binding": "SCHEDULED_VIDEOS",
			"bucket_name": "scheduled-videos",
			"preview_bucket_name": "scheduled-videos-preview",
			"remote": true
		},
		{
			"binding": "scheduled-videos",
			"bucket_name": "scheduled-videos",
			"preview_bucket_name": "scheduled-videos-preview",
			"remote": true
		},
		{
			"binding": "global_settings",
			"bucket_name": "global-settings",
			"preview_bucket_name": "global-settings-preview",
			"remote": true
		},
		{
			// Read-only use: daily view/watch-time rollups written by the processor
			// (analytics/rollups/*) in the processor's messages bucket
			"binding": "analytics_rollups",
			"bucket_name": "al-ummah-now-messages",
			"remote": true
		}
	],
	"d1_databases": [
		{
			// Notification center + library indexes (Epic 29); migrations live in apps/processor.
			"binding": "NOTIFICATIONS_DB",
			"database_name": "al-ummah-now-notifications",
			"database_id": "2479ad9b-76f6-41e6-ac77-69e46faa5e69"
		},
		{
			// Search index (Epic 29, Story 29.9). Schema: migrations/search.
			// After deploy, fill it with scripts/search-backfill.sh until it reports complete (#216).
			"binding": "SEARCH_DB",
			"database_name": "al-ummah-now-search",
			"database_id": "41064871-cf1f-46e9-b102-7b913240ad89",
			"migrations_dir": "migrations/search"
		}
	],
	"kv_namespaces": [
		{
			"binding": "RATE_LIMIT_KV",
			"id": "4771816fd0cc469383de67257280c516",
			"preview_id": "0464af73f01045dc82dd2a1c25c3daa4",
			"remote": true
		},
		{
			"binding": "TUS_SESSIONS",
			"id": "a7f78b8bf0984994a2cd2f4c92169ae1",
			"preview_id": "56c4fbe8aec04166b9256bf951655c3a",
			"remote": true
		}
	],
	"queues": {
		"consumers": [],
		"producers": [
			{
				"queue": "al-ummah-now-videos",
				"binding": "queue"
			}
		]
	},
	"secrets_store_secrets": [
	  {
		"binding": "image_storage_key",
		"store_id": "f8eddc9944d041919ed8dc7d08d32308",
		"secret_name": "al-ummah-now-images-key"
	  },
	  {
		"binding": "bunny-stream-key",
		"store_id": "f8eddc9944d041919ed8dc7d08d32308",
		"secret_name": "bunny-stream-key"
	  },
	  {
		"binding": "bunny_stream_library_id",
		"store_id": "f8eddc9944d041919ed8dc7d08d32308",
		"secret_name": "bunny_stream_library_id"
	  },
	  {
		"binding": "INTERNAL_API_KEY",
		"store_id": "f8eddc9944d041919ed8dc7d08d32308",
		"secret_name": "internal-api-key"
	  },
	  {
		// Bunny CDN token authentication key of legacy library 400189 (vz-215a1ffd)
		"binding": "BUNNY_TOKEN_KEY",
		"store_id": "f8eddc9944d041919ed8dc7d08d32308",
		"secret_name": "bunny-stream-token-key"
	  }
	],
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 */
	// "vars": { "MY_VARIABLE": "production_value" },
	"vars": {
		"ENVIRONMENT": "production",
		"ZONE": "al-ummah-now-images",
		"ClientId": "b1770235-e4b6-42f3-9eb4-3c03ca111b02",
		"Issuer": "https://auth.alummahnow.net",
		"Audience": "https://videos.api.alummahnow.net",
		"bunny_hostname": "vz-25839d05-80d.b-cdn.net",
		// Existing videos live on legacy library 400189 with CDN token auth on:
		// sign its URLs (playUrl, thumbnails) in API responses
		"BUNNY_SIGN_URLS": "true",
		// Name prefix for Bunny videos/collections this env creates (stage: "[stage] "; none in production)
		"BUNNY_NAME_PREFIX": "",
		"BUNNY_SIGN_HOSTNAME": "vz-215a1ffd-a5a.b-cdn.net",
		"WEBSOCKET_URL": "https://realtime.alummahnow.net",
		"CORS_ORIGINS": "https://videos.alummahnow.net,https://alummahnow.net,https://www.alummahnow.net,https://admin.alummahnow.net"
	},
	/**
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": { "directory": "./public/", "binding": "ASSETS" },
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [{ "binding": "MY_SERVICE", "service": "my-service" }]
	"dev": {
		"ip": "127.0.0.1",
		"port": 3086,
		"local_protocol": "http"
	},
	"env": {
		// Stage slot (docs/release-pipeline): same bindings as production, stage resources and hosts.
		"stage": {
			// Workers Logs bills per line: log 10% of invocations (sampling drops errors too)
			"observability": { "enabled": true, "head_sampling_rate": 0.1, "logs": { "enabled": true, "head_sampling_rate": 0.1 } },
			"version_metadata": { "binding": "CF_VERSION_METADATA" },
			"name": "videos-stage",
			"routes": [
				{
					"pattern": "videos.api.stage.alummahnow.net",
					"custom_domain": true
				}
			],
			"r2_buckets": [
				{
					"binding": "videos",
					"bucket_name": "videos-stage"
				},
				{
					"binding": "profiles",
					"bucket_name": "profiles-stage"
				},
				{
					"binding": "channels",
					"bucket_name": "channels-stage"
				},
				{
					"binding": "playlists",
					"bucket_name": "playlists-stage"
				},
				{
					"binding": "reports",
					"bucket_name": "reports-stage"
				},
				{
					"binding": "watch_history",
					"bucket_name": "watch-history-stage"
				},
				{
					"binding": "channel_sections",
					"bucket_name": "channel-sections-stage"
				},
				{
					"binding": "community_posts",
					"bucket_name": "community-posts-stage"
				},
				{
					"binding": "channel_tabs",
					"bucket_name": "channel-tabs-stage"
				},
				{
					"binding": "upload-defaults",
					"bucket_name": "upload-defaults-stage"
				},
				{
					"binding": "subtitles",
					"bucket_name": "subtitles-stage"
				},
				{
					"binding": "SCHEDULED_VIDEOS",
					"bucket_name": "scheduled-videos-stage"
				},
				{
					"binding": "scheduled-videos",
					"bucket_name": "scheduled-videos-stage"
				},
				{
					"binding": "global_settings",
					"bucket_name": "global-settings-stage"
				},
				{
					"binding": "analytics_rollups",
					"bucket_name": "al-ummah-now-messages-stage"
				}
			],
			"d1_databases": [
				{
					"binding": "NOTIFICATIONS_DB",
					"database_name": "al-ummah-now-notifications-stage",
					"database_id": "8626a5a5-0291-4150-ac9e-6083b606a140"
				},
				{
					"binding": "SEARCH_DB",
					"database_name": "al-ummah-now-search-stage",
					"database_id": "956a3550-bd20-4cfc-9bf2-b1c2265b33dd",
					"migrations_dir": "migrations/search"
				}
			],
			"kv_namespaces": [
				{
					"binding": "RATE_LIMIT_KV",
					"id": "2c80e4bba64943a29e4bf091374a1362"
				},
				{
					"binding": "TUS_SESSIONS",
					"id": "a200f6a898594502971558727243e538"
				}
			],
			"queues": {
				"producers": [
					{
						"queue": "al-ummah-now-videos-stage",
						"binding": "queue"
					}
				]
			},
			"secrets_store_secrets": [
				{
					"binding": "image_storage_key",
					"store_id": "f8eddc9944d041919ed8dc7d08d32308",
					"secret_name": "al-ummah-now-images-key"
				},
				{
					"binding": "bunny-stream-key",
					"store_id": "f8eddc9944d041919ed8dc7d08d32308",
					"secret_name": "bunny-stream-key-qa"
				},
				{
					"binding": "bunny_stream_library_id",
					"store_id": "f8eddc9944d041919ed8dc7d08d32308",
					"secret_name": "bunny-stream-library-id-qa"
				},
				{
					"binding": "INTERNAL_API_KEY",
					"store_id": "f8eddc9944d041919ed8dc7d08d32308",
					"secret_name": "internal-api-key-stage"
				},
				{
					"binding": "BUNNY_TOKEN_KEY",
					"store_id": "f8eddc9944d041919ed8dc7d08d32308",
					"secret_name": "bunny-stream-token-key-qa"
				}
			],
			"vars": {
				"ENVIRONMENT": "stage",
				"ZONE": "al-ummah-now-images",
				"ClientId": "b1770235-e4b6-42f3-9eb4-3c03ca111b02",
				"Issuer": "https://auth.stage.alummahnow.net",
				"Audience": "https://videos.api.stage.alummahnow.net",
				"bunny_hostname": "vz-cb79844a-c5d.b-cdn.net",
				"BUNNY_SIGN_URLS": "true",
				// Stage shares the QA Bunny library: tag what stage creates there for cleanup
				"BUNNY_NAME_PREFIX": "[stage] ",
				"BUNNY_SIGN_HOSTNAME": "vz-cb79844a-c5d.b-cdn.net",
				"WEBSOCKET_URL": "https://realtime.stage.alummahnow.net",
				"CORS_ORIGINS": "https://videos.stage.alummahnow.net,https://admin.stage.alummahnow.net"
			}
		}
	}
}
