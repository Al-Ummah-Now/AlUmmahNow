{
  "name": "@al-ummah/api-videos",
  "version": "1.0.0",
  "private": true,
  "description": "Al Ummah Now - Video API Backend with Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev --inspector-port=4086",
    "dev:node": "tsx watch --inspect --env-file=.env.dev src/index.ts",
    "build": "tsc --noEmit",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:qa": "CI=true wrangler deploy --config wrangler.qa.jsonc",
    "cf-typegen": "wrangler types --env-file .dev.vars.example --strict-vars=false",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .wrangler",
    "test": "npm run test:api",
    "test:unit": "tsx --conditions=import --test test/*.spec.ts",
    "openapi:generate": "tsx --conditions=import scripts/generate-openapi.ts",
    "test:api": "curl -s http://127.0.0.1:3086/test | jq .",
    "test:health": "curl -s http://127.0.0.1:3086/health | jq .",
    "test:metrics": "curl -s http://127.0.0.1:3086/metrics | jq .",
    "lint": "eslint src"
  },
  "dependencies": {
    "@al-ummah/logger": "workspace:*",
    "@al-ummah/shared-types": "workspace:*",
    "@bunny.net/storage-sdk": "0.3.0",
    "@al-ummah-now/openauth": "1.0.15",
    "chanfana": "^2.8.0",
    "hono": "^4.12.28",
    "sanitize-html": "^2.14.0",
    "tus-js-client": "^4.3.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251106.1",
    "@types/node": "24.10.0",
    "@types/sanitize-html": "^2.13.0",
    "@types/service-worker-mock": "^2.0.1",
    "tsx": "^4.19.2",
    "typescript": "5.9.3",
    "wrangler": "^4.108.0"
  }
}
