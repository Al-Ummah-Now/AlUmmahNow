{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "videos-qa",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-12",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "observability": {
    "enabled": true,
    // Workers Logs bills per line: log 10% of invocations (sampling drops errors too)
    "head_sampling_rate": 0.1
  },
  "r2_buckets": [
    {
      "binding": "videos",
      "bucket_name": "videos-qa"
    },
    {
      "binding": "profiles",
      "bucket_name": "profiles-qa"
    },
    {
      "binding": "channels",
      "bucket_name": "channels-qa"
    },
    {
      "binding": "playlists",
      "bucket_name": "playlists-qa"
    },
    {
      "binding": "reports",
      "bucket_name": "reports-qa"
    },
    {
      "binding": "watch_history",
      "bucket_name": "watch-history-qa"
    },
    {
      "binding": "channel_sections",
      "bucket_name": "channel-sections-qa"
    },
    {
      "binding": "community_posts",
      "bucket_name": "community-posts-qa"
    },
    {
      "binding": "channel_tabs",
      "bucket_name": "channel-tabs-qa"
    },
    {
      "binding": "upload-defaults",
      "bucket_name": "upload-defaults-qa"
    },
    {
      "binding": "subtitles",
      "bucket_name": "subtitles-qa"
    },
    {
      "binding": "SCHEDULED_VIDEOS",
      "bucket_name": "scheduled-videos-qa"
    },
    {
      "binding": "scheduled-videos",
      "bucket_name": "scheduled-videos-qa"
    },
    {
      "binding": "global_settings",
      "bucket_name": "global-settings-qa"
    },
    {
      "binding": "analytics_rollups",
      "bucket_name": "al-ummah-now-messages-qa"
    }
  ],
  "d1_databases": [
    {
      // Notification center + library indexes (Epic 29); migrations live in apps/processor
      "binding": "NOTIFICATIONS_DB",
      "database_name": "al-ummah-now-notifications-qa",
      "database_id": "61a2966a-66c2-4ae2-a98f-6e2e8cf6b880"
    },
    {
      // Search index (Epic 29, Story 29.9). Schema: migrations/search
      "binding": "SEARCH_DB",
      "database_name": "al-ummah-now-search-qa",
      "database_id": "0282bac3-5b70-4343-a991-937c732d981a",
      "migrations_dir": "migrations/search"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "7da4b66fae594a0e9e5af8ef1e0d698d"
    },
    {
      "binding": "TUS_SESSIONS",
      "id": "89659e4b76fe4f41823ad956990e6731"
    }
  ],
  "queues": {
    "consumers": [],
    "producers": [
      {
        "queue": "al-ummah-now-videos-qa",
        "binding": "queue"
      }
    ]
  },
  "secrets_store_secrets": [
    {
      "binding": "image_storage_key",
      "store_id": "f8eddc9944d041919ed8dc7d08d32308",
      "secret_name": "al-ummah-now-images-key"
    },
    {
      "binding": "bunny-stream-key",
      "store_id": "f8eddc9944d041919ed8dc7d08d32308",
      "secret_name": "bunny-stream-key-qa"
    },
    {
      "binding": "bunny_stream_library_id",
      "store_id": "f8eddc9944d041919ed8dc7d08d32308",
      "secret_name": "bunny-stream-library-id-qa"
    },
    {
      "binding": "INTERNAL_API_KEY",
      "store_id": "f8eddc9944d041919ed8dc7d08d32308",
      "secret_name": "internal-api-key-qa"
    },
    {
      // Bunny Stream CDN token authentication key (signs video URLs)
      "binding": "BUNNY_TOKEN_KEY",
      "store_id": "f8eddc9944d041919ed8dc7d08d32308",
      "secret_name": "bunny-stream-token-key-qa"
    }
  ],
  "vars": {
    "ZONE": "al-ummah-now-images",
    "ClientId": "c1770235-e4b6-42f3-9eb4-3c03ca111b02",
    "Issuer": "https://auth.qa.alummahnow.net",
    "Audience": "https://videos.api.qa.alummahnow.net",
    "bunny_hostname": "vz-cb79844a-c5d.b-cdn.net",
    // Flip to "true" together with enabling CDN token authentication on the library
    "BUNNY_SIGN_URLS": "true",
    "WEBSOCKET_URL": "https://realtime.qa.alummahnow.net",
    "CORS_ORIGINS": "https://videos.qa.alummahnow.net,https://admin.qa.alummahnow.net"
  },
  "dev": {
    "ip": "127.0.0.1",
    "port": 3086,
    "local_protocol": "http"
  }
}
