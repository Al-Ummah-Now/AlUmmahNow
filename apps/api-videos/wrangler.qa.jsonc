{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "videos-qa",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-12",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["17 3 * * *", "47 * * * *", "*/10 * * * *"]
  },
  "observability": {
    "enabled": true,
    // Workers Logs bills per line: log 10% of invocations (sampling drops errors too)
    "head_sampling_rate": 0.1,
    "logs": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  // Per-video view counter (realtime worker, apps/websocket-server/src/view-counter.ts). Cross-script binding: the class lives in the comms worker of the same environment.
  "durable_objects": {
    "bindings": [
      { "name": "VIEW_COUNTER", "class_name": "WebSocketDurableObject", "script_name": "al-ummah-now-comms-qa" }
    ]
  },
  "r2_buckets": [
    {
      "binding": "videos",
      "bucket_name": "videos-qa"
    },
    {
      "binding": "profiles",
      "bucket_name": "profiles-qa"
    },
    {
      "binding": "channels",
      "bucket_name": "channels-qa"
    },
    {
      "binding": "playlists",
      "bucket_name": "playlists-qa"
    },
    {
      "binding": "reports",
      "bucket_name": "reports-qa"
    },
    {
      "binding": "watch_history",
      "bucket_name": "watch-history-qa"
    },
    {
      "binding": "channel_sections",
      "bucket_name": "channel-sections-qa"
    },
    {
      "binding": "community_posts",
      "bucket_name": "community-posts-qa"
    },
    {
      "binding": "channel_tabs",
      "bucket_name": "channel-tabs-qa"
    },
    {
      "binding": "upload-defaults",
      "bucket_name": "upload-defaults-qa"
    },
    {
      "binding": "subtitles",
      "bucket_name": "subtitles-qa"
    },
    {
      "binding": "SCHEDULED_VIDEOS",
      "bucket_name": "scheduled-videos-qa"
    },
    {
      "binding": "scheduled-videos",
      "bucket_name": "scheduled-videos-qa"
    },
    {
      "binding": "global_settings",
      "bucket_name": "global-settings-qa"
    },
    {
      "binding": "analytics_rollups",
      "bucket_name": "al-ummah-now-messages-qa"
    },
    {
      // Private pre-change copies written by admin jobs (legacy profile restore)
      "binding": "ADMIN_BACKUPS",
      "bucket_name": "admin-backups-qa"
    },
    // R2 delivery beside Bunny (epic #687): renditions written by apps/media; api-videos
    // moves them on visibility changes and deletes them at purge
    { "binding": "MEDIA", "bucket_name": "al-ummah-now-media-qa" },
    { "binding": "MEDIA_PRIVATE", "bucket_name": "al-ummah-now-media-private-qa" },
    // Uploads as received, for the R2 transcode (docs/media-delivery/ORIGINALS.md)
    { "binding": "MEDIA_ORIGINALS", "bucket_name": "al-ummah-now-media-originals-qa" }
  ],
  "d1_databases": [
    {
      // Notification center + library indexes (Epic 29); migrations live in apps/processor
      "binding": "NOTIFICATIONS_DB",
      "database_name": "al-ummah-now-notifications-qa",
      "database_id": "61a2966a-66c2-4ae2-a98f-6e2e8cf6b880"
    },
    {
      // Search index (Epic 29, Story 29.9). Schema: migrations/search
      "binding": "SEARCH_DB",
      "database_name": "al-ummah-now-search-qa",
      "database_id": "0282bac3-5b70-4343-a991-937c732d981a",
      "migrations_dir": "migrations/search"
    },
    {
      // Auth service D1 (QA), READ ONLY: legacy profile restore (lib/admin/legacy-restore.ts)
      "binding": "AUTH_DB",
      "database_name": "al-ummah-now-d1-qa",
      "database_id": "28590f3c-dd92-4c26-a803-d73a9bbe2b58"
    }
  ],
  // Watch-time reports per playback session (#235); videoWatchTime.ts
  "ratelimits": [
    { "name": "WATCH_TIME_LIMITER", "namespace_id": "2203", "simple": { "limit": 6, "period": 60 } },
    // Typeahead lookups per user or IP (GET /api/search/suggestions)
    { "name": "SUGGEST_LIMITER", "namespace_id": "2223", "simple": { "limit": 120, "period": 60 } }
  ],
  "kv_namespaces": [
			// Token revocation list written by the auth worker (#437)
			{ "binding": "TOKEN_REVOCATIONS", "id": "e6e662fc9cd9420797ddfa8060eb6956" },
    {
      "binding": "TUS_SESSIONS",
      "id": "89659e4b76fe4f41823ad956990e6731"
    }
  ],
  "queues": {
    // Per-video processing-check loop (src/lib/processing/loop.ts)
    "consumers": [
      {
        "queue": "al-ummah-now-processing-check-qa",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "al-ummah-now-dlq-qa"
      },
      {
        // Heavy admin actions (lib/admin/jobs.ts). One job per invocation: each gets the full subrequest budget.
        "queue": "al-ummah-now-run-erase-qa",
        // E2E run-account erasures (#887): their own queue, at most 3 at once, so the sweep never
        // holds up admin jobs (712 queued erasures blocked them for hours on 2026-11-11)
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_concurrency": 3,
        "max_retries": 5,
        "dead_letter_queue": "al-ummah-now-dlq-qa"
      },
      {
        "queue": "al-ummah-now-admin-jobs-qa",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "al-ummah-now-dlq-qa"
      }
    ],
    "producers": [
      {
        "queue": "al-ummah-now-processing-check-qa",
        "binding": "PROCESSING_CHECK_QUEUE"
      },
      {
        "queue": "al-ummah-now-videos-qa",
        "binding": "queue"
      },
      {
        "queue": "al-ummah-now-moderation-qa",
        "binding": "MODERATION_QUEUE"
      },
      {
        "queue": "al-ummah-now-admin-jobs-qa",
        "binding": "ADMIN_JOBS_QUEUE"
      },
      {
        "queue": "al-ummah-now-run-erase-qa",
        "binding": "RUN_ERASE_QUEUE"
      },
      {
        // R2 transcodes (apps/media consumes)
        "queue": "al-ummah-now-transcode-qa",
        "binding": "TRANSCODE_QUEUE"
      }
    ]
  },
  "secrets_store_secrets": [
    {
      "binding": "image_storage_key",
      "store_id": "f8eddc9944d041919ed8dc7d08d32308",
      "secret_name": "al-ummah-now-images-key"
    },
    {
      "binding": "bunny-stream-key",
      "store_id": "f8eddc9944d041919ed8dc7d08d32308",
      "secret_name": "bunny-stream-key-qa"
    },
    {
      "binding": "bunny_stream_library_id",
      "store_id": "f8eddc9944d041919ed8dc7d08d32308",
      "secret_name": "bunny-stream-library-id-qa"
    },
    {
      "binding": "INTERNAL_API_KEY",
      "store_id": "f8eddc9944d041919ed8dc7d08d32308",
      "secret_name": "internal-api-key-qa"
    },
    {
      // Bunny Stream CDN token authentication key (signs video URLs)
      "binding": "BUNNY_TOKEN_KEY",
      "store_id": "f8eddc9944d041919ed8dc7d08d32308",
      "secret_name": "bunny-stream-token-key-qa"
    },
    {
      // Path tokens of private R2 renditions (shared with apps/media)
      "binding": "MEDIA_SIGN_KEY",
      "store_id": "f8eddc9944d041919ed8dc7d08d32308",
      "secret_name": "media-sign-key-qa"
    },
    {
    	// Cloudflare token (Secrets Store media-cdn-api-token): CDN purge when a video turns private; R2 and media-host analytics for the daily costs
    	"binding": "MEDIA_CDN_API_TOKEN",
    	"store_id": "f8eddc9944d041919ed8dc7d08d32308",
    	"secret_name": "media-cdn-api-token"
    },
    {
    	"binding": "MEDIA_ANALYTICS_TOKEN",
    	"store_id": "f8eddc9944d041919ed8dc7d08d32308",
    	"secret_name": "media-cdn-api-token"
    }
  ],
  "vars": {
    // Error reports to the admin Errors page (docs/features/error-reporting.md)
    "ERRORS_INGEST_URL": "https://admin.api.qa.alummahnow.net/internal/errors",
    // R2 delivery host (public renditions direct from R2, private ones via apps/media)
    "MEDIA_PUBLIC_HOST": "media.qa.alummahnow.net",
    // Cloudflare analytics filters for the daily cost inputs (lib/media/costs.ts)
    "MEDIA_BUCKET_NAMES": "al-ummah-now-media-qa,al-ummah-now-media-private-qa,al-ummah-now-media-originals-qa",
    "ORIGINALS_RETENTION_DAYS": "30",
    "ORIGINALS_MAX_DAYS": "90",
    // Max concurrent transcodes: max_instances of the QA transcoder container (apps/media/wrangler.qa.jsonc)
    "MEDIA_MAX_TRANSCODES": "2",
    // Logging policy (docs/operations/logging.md): production warn, stage info, QA/dev debug
    "LOG_LEVEL": "debug",
    // Upload limits enforced (any value but "off"): the numbers come from each user's creator tier, edited in the videos admin (middleware/upload-limits.ts)
    "UPLOAD_RATE_LIMIT": "relaxed",
    "ZONE": "al-ummah-now-images",
    "ClientId": "c1770235-e4b6-42f3-9eb4-3c03ca111b02",
    "Issuer": "https://auth.qa.alummahnow.net",
    "Audience": "https://videos.api.qa.alummahnow.net",
    "bunny_hostname": "vz-cb79844a-c5d.b-cdn.net",
    // Flip to "true" together with enabling CDN token authentication on the library
    "BUNNY_SIGN_URLS": "true",
    // QA and stage share a test Bunny library: allows the admin test-library purge (lib/uploads/testLibraryPurge.ts). Never in production.
    "BUNNY_TEST_LIBRARY": "true",
    "WEBSOCKET_URL": "https://realtime.qa.alummahnow.net",
    "CORS_ORIGINS": "https://videos.qa.alummahnow.net,https://admin.qa.alummahnow.net,https://qa.alummahnow.net,https://www.qa.alummahnow.net,https://cms.qa.alummahnow.net"
  },
  "dev": {
    "ip": "127.0.0.1",
    "port": 3086,
    "local_protocol": "http"
  }
}
