{
	"name": "al-ummah-scheduler",
	"main": "src/index.ts",
	"compatibility_date": "2025-01-20",
	"compatibility_flags": ["nodejs_compat"],
	// Logging policy (docs/operations/logging.md): the cron runs every minute, so the
	// automatic per-invocation log is off; a tick logs only when it fails or is slow.
	// Every invocation is sampled so no error line is dropped.
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false }
	},

	// Run every minute
	"triggers": {
		"crons": ["* * * * *"]
	},

	// R2 Buckets
	"r2_buckets": [
		{
			"binding": "VIDEOS",
			"bucket_name": "videos",
			"preview_bucket_name": "videos-preview",
			"remote": true
		},
		{
			"binding": "SCHEDULED_VIDEOS",
			"bucket_name": "scheduled-videos",
			"preview_bucket_name": "scheduled-videos-preview",
			"remote": true
		}
	],

	// Queue for events
	"queues": {
		"producers": [
			{
				"queue": "al-ummah-now-videos",
				"binding": "QUEUE"
			}
		]
	},

	// KV for distributed locks
	"kv_namespaces": [
		{
			"binding": "SCHEDULER_LOCKS",
			"id": "d254593e8a0e4fc48598e95936780a70",
			"preview_id": "b8f39eddc46f4613831fcfdc514d5eb0",
			"remote": true
		},
		{
			"binding": "SCHEDULER_METRICS",
			"id": "9ccbc2f12cb5497c9fcc64ecf9de7b96",
			"preview_id": "fb45dee7ba9a423aa7c5645fb9545c0f",
			"remote": true
		}
	],

	// Durable Objects for distributed locks (atomic)
	"durable_objects": {
		"bindings": [
			{
				"name": "SCHEDULER_LOCK",
				"class_name": "SchedulerLock"
			}
		]
	},

	"migrations": [
		{
			"tag": "v1",
			"new_classes": ["SchedulerLock"]
		}
	],

	// Secrets Store: authenticates /broadcast calls to the websocket server.
	// Needs wrangler 4; wrangler 3 silently drops secrets_store_secrets.
	"secrets_store_secrets": [
		{
			"binding": "INTERNAL_API_KEY",
			"store_id": "f8eddc9944d041919ed8dc7d08d32308",
			"secret_name": "internal-api-key"
		}
	],

	// Environment variables
	"vars": {
		// Error reports to the admin Errors page (docs/features/error-reporting.md)
		"ERRORS_INGEST_URL": "https://admin.api.alummahnow.net/internal/errors",
		// Logging policy (docs/operations/logging.md): production warn, stage info, QA/dev debug
		"LOG_LEVEL": "warn",
		"ENVIRONMENT": "production",
		"MAX_RETRIES": "3",
		"BATCH_SIZE": "50",
		"LOCK_TTL": "120",
		"WEBSOCKET_URL": "https://realtime.alummahnow.net"
	},

	// Development server configuration
	"dev": {
		"ip": "127.0.0.1",
		"port": 3092,
		"local_protocol": "http"
	},
	"env": {
		// Stage slot (docs/release-pipeline): same bindings as production, stage resources and hosts.
		"stage": {
			"name": "al-ummah-scheduler-stage",
			"r2_buckets": [
				{
					"binding": "VIDEOS",
					"bucket_name": "videos-stage"
				},
				{
					"binding": "SCHEDULED_VIDEOS",
					"bucket_name": "scheduled-videos-stage"
				}
			],
			"queues": {
				"producers": [
					{
						"queue": "al-ummah-now-videos-stage",
						"binding": "QUEUE"
					}
				]
			},
			"kv_namespaces": [
				{
					"binding": "SCHEDULER_LOCKS",
					"id": "900ce7c520d34c39a0c5dd6fe3db1357"
				},
				{
					"binding": "SCHEDULER_METRICS",
					"id": "ca609f05ff684939ab6595e40cbc5090"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "SCHEDULER_LOCK",
						"class_name": "SchedulerLock"
					}
				]
			},
			"secrets_store_secrets": [
				{
					"binding": "INTERNAL_API_KEY",
					"store_id": "f8eddc9944d041919ed8dc7d08d32308",
					"secret_name": "internal-api-key-stage"
				}
			],
			"vars": {
				// Error reports to the admin Errors page (docs/features/error-reporting.md)
				"ERRORS_INGEST_URL": "https://admin.api.stage.alummahnow.net/internal/errors",
				// Logging policy (docs/operations/logging.md): production warn, stage info, QA/dev debug
				"LOG_LEVEL": "info",
				"ENVIRONMENT": "stage",
				"MAX_RETRIES": "3",
				"BATCH_SIZE": "50",
				"LOCK_TTL": "120",
				"WEBSOCKET_URL": "https://realtime.stage.alummahnow.net"
			}
		}
	}
}
