{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "al-ummah-admin-web-qa",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-12",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "logpush": true,
  "minify": true,
  // esbuild keepNames injects __name() into fn.toString() output, breaking
  // next-themes inline script in the browser ("e is not defined").
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    // Workers Logs bills per line: log 10% of invocations (sampling drops errors too)
    "head_sampling_rate": 0.1,
    "logs": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "upload_source_maps": true,
  "vars": {
    "Issuer": "https://auth.qa.alummahnow.net",
    "OPENAUTH_ISSUER": "https://auth.qa.alummahnow.net",
    "NEXTJS_ENV": "qa",
    "API_URL": "https://videos.api.qa.alummahnow.net",
    "ADMIN_API_URL": "https://admin.api.qa.alummahnow.net",
    "NEXT_PUBLIC_API_URL": "https://videos.api.qa.alummahnow.net",
    "NEXT_PUBLIC_BASE_URL": "https://admin.qa.alummahnow.net",
    "ClientId": "b24e39de-601d-463b-b50d-37a0a94e986b"
  }
}
