{
  "name": "al-ummah-admin-web",
  "main": "worker.ts",
  // Skew protection: old pages are served by the Worker version that built
  // them, through that version's preview URL (open-next.config.ts)
  "preview_urls": true,
  "compatibility_date": "2025-04-12",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "logpush": true,
  "minify": true,
  // esbuild keepNames injects __name() into fn.toString() output, breaking
  // next-themes inline script in the browser ("e is not defined").
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // The Worker sees chunk requests first, so `?dpl=<old build>` reaches the
    // old version's assets (skew protection). Must match in every config: the
    // OpenNext build reads it from wrangler.jsonc.
    "run_worker_first": ["/_next/static/*"]
  },
  "observability": {
    "enabled": true,
    // Low traffic: keep every invocation. Lower this when traffic grows.
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1 }
  },
  "upload_source_maps": true,
  "vars": {
    "CF_WORKER_NAME": "al-ummah-admin-web",
    "CF_PREVIEW_DOMAIN": "mahmoud-s-darwish",
    "Issuer": "https://auth.alummahnow.net",
    "OPENAUTH_ISSUER": "https://auth.alummahnow.net",
    "NEXTJS_ENV": "production",
    "API_URL": "https://videos.api.alummahnow.net",
    "ADMIN_API_URL": "https://admin.api.alummahnow.net",
    "NEXT_PUBLIC_API_URL": "https://videos.api.alummahnow.net",
    "NEXT_PUBLIC_BASE_URL": "https://admin.alummahnow.net",
    "ClientId": "a24e39de-601d-463b-b50d-37a0a94e986b"
  },
  // Production custom domain (zone alummahnow.net)
  "routes": [
    {
      "pattern": "admin.alummahnow.net",
      "custom_domain": true
    }
  ],
  "env": {
    // Stage slot (docs/release-pipeline): same bindings as production, stage resources and hosts.
    "stage": {
      // Workers Logs bills per line: log 10% of invocations (sampling drops errors too)
      "observability": { "enabled": true, "head_sampling_rate": 0.1, "logs": { "enabled": true, "head_sampling_rate": 0.1 } },
      "name": "al-ummah-admin-web-stage",
      "preview_urls": true,
      "routes": [
        {
          "pattern": "admin.stage.alummahnow.net",
          "custom_domain": true
        }
      ],
      "vars": {
        "CF_WORKER_NAME": "al-ummah-admin-web-stage",
        "CF_PREVIEW_DOMAIN": "mahmoud-s-darwish",
        "Issuer": "https://auth.stage.alummahnow.net",
        "OPENAUTH_ISSUER": "https://auth.stage.alummahnow.net",
        "NEXTJS_ENV": "stage",
        "API_URL": "https://videos.api.stage.alummahnow.net",
        "ADMIN_API_URL": "https://admin.api.stage.alummahnow.net",
        "NEXT_PUBLIC_API_URL": "https://videos.api.stage.alummahnow.net",
        "NEXT_PUBLIC_BASE_URL": "https://admin.stage.alummahnow.net",
        "ClientId": "a24e39de-601d-463b-b50d-37a0a94e986b"
      }
    }
  }
}
