{
  "name": "al-ummah-admin-web",
  "main": "worker.ts",
  // Skew protection: old pages are served by the Worker version that built
  // them, through that version's preview URL (open-next.config.ts)
  "preview_urls": true,
  "compatibility_date": "2025-04-12",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
    // Skew protection fetches an old version through its workers.dev preview URL.
    // Without this flag a Worker's fetch to a workers.dev URL of its own account
    // fails (error 1042, a 522 on the custom domain): release v2026.11.10.4.
    "global_fetch_strictly_public"
  ],
  "logpush": true,
  "minify": true,
  // esbuild keepNames injects __name() into fn.toString() output, breaking
  // next-themes inline script in the browser ("e is not defined").
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // The Worker sees chunk requests first, so `?dpl=<old build>` reaches the
    // old version's assets (skew protection). Must match in every config: the
    // OpenNext build reads it from wrangler.jsonc.
    "run_worker_first": ["/_next/static/*"]
  },
  "observability": {
    "enabled": true,
    // Low traffic (admins only): every invocation and its invocation log are kept (docs/operations/logging.md).
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1 }
  },
  "upload_source_maps": true,
  "vars": {
    // Logging policy (docs/operations/logging.md): warn on production, stage and QA (only warnings, errors, slow requests); debug locally
    "LOG_LEVEL": "warn",
    "CF_WORKER_NAME": "al-ummah-admin-web",
    "CF_PREVIEW_DOMAIN": "mahmoud-s-darwish",
    "Issuer": "https://auth.alummahnow.net",
    "OPENAUTH_ISSUER": "https://auth.alummahnow.net",
    "NEXTJS_ENV": "production",
    "API_URL": "https://videos.api.alummahnow.net",
    "ADMIN_API_URL": "https://admin.api.alummahnow.net",
    "NEXT_PUBLIC_API_URL": "https://videos.api.alummahnow.net",
    "NEXT_PUBLIC_BASE_URL": "https://admin.alummahnow.net",
    "ERRORS_INGEST_URL": "https://admin.api.alummahnow.net/internal/errors",
    "ClientId": "a24e39de-601d-463b-b50d-37a0a94e986b"
  },
  "secrets_store_secrets": [
    // X-API-Key for admin-api /internal/errors (app/api/errors/route.ts, instrumentation.ts)
    { "binding": "INTERNAL_API_KEY", "store_id": "f8eddc9944d041919ed8dc7d08d32308", "secret_name": "internal-api-key" }
  ],
  // Production custom domain (zone alummahnow.net)
  "routes": [
    {
      "pattern": "admin.alummahnow.net",
      "custom_domain": true
    }
  ],
  "env": {
    // Stage slot (docs/release-pipeline): same bindings as production, stage resources and hosts.
    "stage": {
      // No Logpush job reads these logs; Workers Logs covers them
      "logpush": false,
      // Workers Logs bills per line: every invocation kept (sampling would drop errors), no invocation log, LOG_LEVEL warn
      "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false } },
      "name": "al-ummah-admin-web-stage",
      "preview_urls": true,
      "routes": [
        {
          "pattern": "admin.stage.alummahnow.net",
          "custom_domain": true
        }
      ],
      "vars": {
        // Logging policy (docs/operations/logging.md): warn on production, stage and QA (only warnings, errors, slow requests); debug locally
        "LOG_LEVEL": "warn",
        "CF_WORKER_NAME": "al-ummah-admin-web-stage",
        "CF_PREVIEW_DOMAIN": "mahmoud-s-darwish",
        "Issuer": "https://auth.stage.alummahnow.net",
        "OPENAUTH_ISSUER": "https://auth.stage.alummahnow.net",
        "NEXTJS_ENV": "stage",
        "API_URL": "https://videos.api.stage.alummahnow.net",
        "ADMIN_API_URL": "https://admin.api.stage.alummahnow.net",
        "NEXT_PUBLIC_API_URL": "https://videos.api.stage.alummahnow.net",
        "NEXT_PUBLIC_BASE_URL": "https://admin.stage.alummahnow.net",
        "ERRORS_INGEST_URL": "https://admin.api.stage.alummahnow.net/internal/errors",
        "ClientId": "a24e39de-601d-463b-b50d-37a0a94e986b"
      },
      "secrets_store_secrets": [
        // X-API-Key for admin-api /internal/errors (app/api/errors/route.ts, instrumentation.ts)
        { "binding": "INTERNAL_API_KEY", "store_id": "f8eddc9944d041919ed8dc7d08d32308", "secret_name": "internal-api-key-stage" }
      ]
    }
  }
}
