{
  "name": "@al-ummah/admin-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3091",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "start": "next start --port 3091",
    "preview": "opennextjs-cloudflare build && wrangler dev",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "deploy:qa": "opennextjs-cloudflare build && CI=true wrangler deploy --config wrangler.qa.jsonc",
    "lint": "eslint src",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@al-ummah/logger": "workspace:*",
    "@al-ummah/shared-types": "workspace:*",
    "@al-ummah-now/openauth": "1.0.15",
    "@opennextjs/cloudflare": "^1.11.1",
    "@tanstack/react-query": "^5.90.11",
    "next": "15.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "valibot": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.1",
    "tailwindcss": "^4.0.3",
    "typescript": "^5.6.3",
    "wrangler": "^4.51.0"
  }
}
