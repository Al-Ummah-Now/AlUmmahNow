# Cloudflare Workers static-asset headers (copied to .open-next/assets).
# Tab and app icons: fixed names, so a day fresh and a week stale-while-revalidate
/favicon*
  Cache-Control: public,max-age=86400,stale-while-revalidate=604800
/apple-touch-icon.png
  Cache-Control: public,max-age=86400,stale-while-revalidate=604800
/icon-*
  Cache-Control: public,max-age=86400,stale-while-revalidate=604800
/site.webmanifest
  Cache-Control: public,max-age=86400,stale-while-revalidate=604800
