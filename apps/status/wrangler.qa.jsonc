{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Public status page, QA (docs/status-page/README.md): checks QA's own hosts every 5 minutes
  "name": "al-ummah-status-qa",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "status.qa.alummahnow.net", "custom_domain": true }],
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false } },
  "triggers": { "crons": ["*/5 * * * *", "40 3 * * *"] },
  "d1_databases": [
    { "binding": "STATUS_DB", "database_name": "al-ummah-now-status-qa", "database_id": "c8ff2997-91a2-4ec8-bd0a-d9b729d17573", "migrations_dir": "migrations" }
  ],
  "secrets_store_secrets": [
    { "binding": "INTERNAL_API_KEY", "store_id": "f8eddc9944d041919ed8dc7d08d32308", "secret_name": "internal-api-key-qa" }
  ],
  "vars": {
    "ENVIRONMENT": "qa",
    "LOG_LEVEL": "warn",
    "ERRORS_INGEST_URL": "https://admin.api.qa.alummahnow.net/internal/errors"
  }
}
