{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "al-ummah-now-processor-qa",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-01",
  "compatibility_flags": ["nodejs_compat"],

  "d1_databases": [
    {
      "binding": "REPORTS_DB",
      "database_name": "al-ummah-now-reports-qa",
      "database_id": "eed66c4a-af26-4e07-9f9a-36f1e4ada555"
    },
    {
      // Notification center + library indexes (Epic 29). Processor owns the migrations:
      // npx wrangler d1 migrations apply al-ummah-now-notifications-qa --remote --config wrangler.qa.jsonc
      "binding": "NOTIFICATIONS_DB",
      "database_name": "al-ummah-now-notifications-qa",
      "database_id": "61a2966a-66c2-4ae2-a98f-6e2e8cf6b880",
      "migrations_dir": "migrations-notifications"
    },
    {
      // Search index shared with api-videos (schema owned by apps/api-videos/migrations/search)
      "binding": "SEARCH_DB",
      "database_name": "al-ummah-now-search-qa",
      "database_id": "0282bac3-5b70-4343-a991-937c732d981a"
    }
  ],

  // Daily notification retention sweep (90 days)
  "triggers": {
    "crons": ["41 3 * * *", "17 * * * *"]
  },

  "r2_buckets": [
    {
      "binding": "MESSAGES_BUCKET",
      "bucket_name": "al-ummah-now-messages-qa"
    },
    {
      "binding": "community_posts",
      "bucket_name": "community-posts-qa"
    },
    {
      // AI category suggestions (src/categorize): read video text, write `category`
      "binding": "videos",
      "bucket_name": "videos-qa"
    },
    {
      "binding": "subtitles",
      "bucket_name": "subtitles-qa"
    },
    {
      // Pre-publication review (never runs on QA; bound so the config matches production)
      "binding": "REVIEW_MEDIA",
      "bucket_name": "al-ummah-now-media-private-qa"
    }
  ],
  "services": [{ "binding": "VIDEOS", "service": "videos-qa" }],

  "queues": {
    // Epic 9.4: the processor enqueues PushDispatch messages to its own queue
    "producers": [{ "queue": "al-ummah-now-videos-qa", "binding": "MESSAGE_QUEUE" }, { "queue": "al-ummah-now-dlq-qa", "binding": "DLQ" }],
    "consumers": [
      {
        "queue": "al-ummah-now-videos-qa",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "dead_letter_queue": "al-ummah-now-dlq-qa"
      },
      {
        "queue": "al-ummah-now-moderation-qa",
        "max_batch_size": 5,
        "max_batch_timeout": 10,
        "max_retries": 3,
        "dead_letter_queue": "al-ummah-now-dlq-qa"
      },
      {
        // Dead letters: logged as an alert and stored in NOTIFICATIONS_DB.dead_letters
        // (src/dlq). No dead_letter_queue of its own: a DLQ for the DLQ would loop.
        "queue": "al-ummah-now-dlq-qa",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 10
      }
    ]
  },

  "vars": {

    // Pre-publication video review (wiki AUN-VIDEO-REVIEW): production only, never QA

    "VIDEO_REVIEW_ALLOWED": "false",
    // Error reports to the admin Errors page (docs/features/error-reporting.md)
    "ERRORS_INGEST_URL": "https://admin.api.qa.alummahnow.net/internal/errors",
    "ENVIRONMENT": "qa",
    // Archive only client analytics to R2 (apps/processor/src/types.ts MESSAGE_ARCHIVE)
    "MESSAGE_ARCHIVE": "client-analytics",
    // Logging policy (docs/operations/logging.md): warn on production, stage and QA (only warnings, errors, slow requests); debug locally
    "LOG_LEVEL": "warn",
    "WEBSOCKET_URL": "https://realtime.qa.alummahnow.net",
    "CMS_INTERNAL_URL": "https://cms.qa.alummahnow.net",
    // Owner 2026-11-13 (VR13, #1242): AI moderation is production-only; never on QA
    "AI_MODERATION_ENABLED": "false",
    "AI_MODERATION_DAILY_NEURON_CAP": "10000",
    "AI_CATEGORIZE_ENABLED": "true",
    "AI_CATEGORIZE_DAILY_NEURON_CAP": "20000",
    // Release E2E: [e2e-category:<value>] in a title is answered without a model call. Never in production.
    "CATEGORY_AI_TEST_HOOK": "true",
    // Quran Foundation Content Sync (AUN-CAPTIONS): production QF hosts in every env
    "QF_OAUTH_HOST": "https://oauth2.quran.foundation",
    "QF_API_HOST": "https://apis.quran.foundation"
  },

  // Workers AI (Epic 28 moderation)
  "ai": { "binding": "AI" },

  "secrets_store_secrets": [
    {
      "binding": "INTERNAL_API_KEY",
      "store_id": "f8eddc9944d041919ed8dc7d08d32308",
      "secret_name": "internal-api-key-qa"
    },
    {
      // Quran Foundation Content API (AUN-CAPTIONS Content Sync): the production client in every env (owner 2026-11-13)
      "binding": "QF_CLIENT_ID",
      "store_id": "f8eddc9944d041919ed8dc7d08d32308",
      "secret_name": "quran-foundation-prod-client-id"
    },
    {
      "binding": "QF_CLIENT_SECRET",
      "store_id": "f8eddc9944d041919ed8dc7d08d32308",
      "secret_name": "quran-foundation-prod-client-secret"
    }
  ],

  "observability": {

    "enabled": true,

    // Workers Logs bills per line (docs/operations/logging.md): keep every invocation
    // (head sampling would drop errors too), no automatic per-invocation log, and
    // LOG_LEVEL warn below, so only warnings, errors and slow requests are written

    "head_sampling_rate": 1,

    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false }

  },

  "dev": {
    "ip": "127.0.0.1",
    "port": 3088,
    "local_protocol": "http"
  }
}
