{
	"name": "al-ummah-now-processor",
	"main": "src/index.ts",
	"compatibility_date": "2024-09-01",
	"compatibility_flags": ["nodejs_compat"],

	// D1 database for moderation
	"d1_databases": [
		{
			"binding": "REPORTS_DB",
			"database_name": "al-ummah-now-reports",
			"database_id": "7bee932d-c6b1-47c2-ab70-7dba349104af"
		},
		{
			// Notification center + library indexes (Epic 29). Shared with api-videos.
			"binding": "NOTIFICATIONS_DB",
			"database_name": "al-ummah-now-notifications",
			"database_id": "2479ad9b-76f6-41e6-ac77-69e46faa5e69",
			"migrations_dir": "migrations-notifications"
		},
		{
			// Search index shared with api-videos (schema: apps/api-videos/migrations/search).
			"binding": "SEARCH_DB",
			"database_name": "al-ummah-now-search",
			"database_id": "41064871-cf1f-46e9-b102-7b913240ad89"
		}
	],

	// Daily notification retention sweep (90 days)
	"triggers": {
		"crons": ["41 3 * * *", "17 * * * *"]
	},

	// R2 bucket configuration
	"r2_buckets": [
		{
			"binding": "MESSAGES_BUCKET",
			"bucket_name": "al-ummah-now-messages",
			"remote": true
		},
		{
			"binding": "community_posts",
			"bucket_name": "community-posts",
			"preview_bucket_name": "community-posts-preview",
			"remote": true
		},
		{
			// AI category suggestions (src/categorize): read video text, write `category` (conditional writes)
			"binding": "videos",
			"bucket_name": "videos",
			"remote": true
		},
		{
			// Captions read for category suggestions
			"binding": "subtitles",
			"bucket_name": "subtitles",
			"remote": true
		},
		{
			// Pre-publication review (docs/specs/VIDEO-REVIEW.md §4): frames, audio, manifests under review/
			"binding": "REVIEW_MEDIA",
			"bucket_name": "al-ummah-now-media-private",
			"remote": true
		}
	],
	// Pre-publication review: the automated outcome goes to api-videos /internal/review/*
	"services": [{ "binding": "VIDEOS", "service": "videos" }],

	// Queue configuration
	"queues": {
		// Epic 9.4: the processor enqueues PushDispatch messages to its own queue
		"producers": [{ "queue": "al-ummah-now-videos", "binding": "MESSAGE_QUEUE" }, { "queue": "al-ummah-now-dlq", "binding": "DLQ" }, { "queue": "al-ummah-now-review-alerts", "binding": "REVIEW_ALERTS_QUEUE" }],
		"consumers": [
			{
				"queue": "al-ummah-now-videos",
				"max_batch_size": 10,
				"max_batch_timeout": 30,
				"max_retries": 3,
				"dead_letter_queue": "al-ummah-now-dlq"
			},
			{
				"queue": "al-ummah-now-moderation",
				"max_batch_size": 5,
				"max_batch_timeout": 10,
				"max_retries": 3,
				"dead_letter_queue": "al-ummah-now-dlq"
			},
			{
				// Review alerts for the Admin app (#1265): one message per batch, sent within 1 s.
				// Escalations are delayed messages to the same queue. Review runs in production only.
				"queue": "al-ummah-now-review-alerts",
				"max_batch_size": 1,
				"max_batch_timeout": 1,
				"max_retries": 3,
				"dead_letter_queue": "al-ummah-now-dlq"
			},
			{
				// Dead letters: logged as an alert and stored in NOTIFICATIONS_DB.dead_letters
				// (src/dlq). No dead_letter_queue of its own: a DLQ for the DLQ would loop.
				"queue": "al-ummah-now-dlq",
				"max_batch_size": 10,
				"max_batch_timeout": 30,
				"max_retries": 10
			}
		]
	},

	// Environment variables
	"vars": {
		// Pre-publication video review (wiki AUN-VIDEO-REVIEW): production only. QA, stage and previews keep it "false"
		"VIDEO_REVIEW_ALLOWED": "true",
		// Error reports to the admin Errors page (docs/features/error-reporting.md)
		"ERRORS_INGEST_URL": "https://admin.api.alummahnow.net/internal/errors",
		"ENVIRONMENT": "production",
		// Which queue messages are archived to R2 (apps/processor/src/types.ts MESSAGE_ARCHIVE)
		"MESSAGE_ARCHIVE": "all",
		// Logging policy (docs/operations/logging.md): warn on production, stage and QA (only warnings, errors, slow requests); debug locally
		"LOG_LEVEL": "warn",
		"WEBSOCKET_URL": "https://realtime.alummahnow.net",
		// Scholar post reference outbox (src/handlers/scholar-refs.ts): the CMS's /internal/refs
		"CMS_INTERNAL_URL": "https://cms.alummahnow.net",
		// Epic 28: env kill switch ("false" = no AI calls) and default daily cap; D1 moderation_config
		// must ALSO enable it (off until an Admin turns it on in admin-web).
		"AI_MODERATION_ENABLED": "true",
		"AI_MODERATION_DAILY_NEURON_CAP": "100000",
		// AI category suggestions: env kill switch and default daily cap (admin-web overrides the cap)
		"AI_CATEGORIZE_ENABLED": "true",
		"AI_CATEGORIZE_DAILY_NEURON_CAP": "20000",
		// QA/stage release E2E hook; must stay "false" here (pinned by pnpm check:config)
		"CATEGORY_AI_TEST_HOOK": "false",
		// Quran Foundation Content Sync (AUN-CAPTIONS): production QF hosts in every env
		"QF_OAUTH_HOST": "https://oauth2.quran.foundation",
		"QF_API_HOST": "https://apis.quran.foundation"
	},

	// Workers AI (Epic 28 moderation)
	"ai": { "binding": "AI" },

	// Secrets Store
	"secrets_store_secrets": [
		{
			"binding": "INTERNAL_API_KEY",
			"store_id": "f8eddc9944d041919ed8dc7d08d32308",
			"secret_name": "internal-api-key"
		},
		{
			// Quran Foundation Content API (AUN-CAPTIONS Content Sync): the production client in every env (owner 2026-11-13)
			"binding": "QF_CLIENT_ID",
			"store_id": "f8eddc9944d041919ed8dc7d08d32308",
			"secret_name": "quran-foundation-prod-client-id"
		},
		{
			"binding": "QF_CLIENT_SECRET",
			"store_id": "f8eddc9944d041919ed8dc7d08d32308",
			"secret_name": "quran-foundation-prod-client-secret"
		},
		// Push senders (#414, src/push/senders): a placeholder value keeps that provider log-only
		{ "binding": "APNS_KEY_P8", "store_id": "f8eddc9944d041919ed8dc7d08d32308", "secret_name": "apns-key-p8" },
		{ "binding": "APNS_KEY_ID", "store_id": "f8eddc9944d041919ed8dc7d08d32308", "secret_name": "apns-key-id" },
		{ "binding": "APPLE_TEAM_ID", "store_id": "f8eddc9944d041919ed8dc7d08d32308", "secret_name": "apple-team-id" },
		{ "binding": "APNS_BUNDLE_IDS", "store_id": "f8eddc9944d041919ed8dc7d08d32308", "secret_name": "apns-bundle-ids" },
		{ "binding": "FCM_SERVICE_ACCOUNT", "store_id": "f8eddc9944d041919ed8dc7d08d32308", "secret_name": "fcm-service-account" },
		{ "binding": "FCM_PROJECT_ID", "store_id": "f8eddc9944d041919ed8dc7d08d32308", "secret_name": "fcm-project-id" },
		{ "binding": "WNS_PACKAGE_SID", "store_id": "f8eddc9944d041919ed8dc7d08d32308", "secret_name": "wns-package-sid" },
		{ "binding": "WNS_CLIENT_SECRET", "store_id": "f8eddc9944d041919ed8dc7d08d32308", "secret_name": "wns-client-secret" }
	],

	// Environment-specific configurations
	"env": {
		// Stage slot (docs/release-pipeline): same bindings as production, stage resources and hosts.
		"stage": {
			// Workers Logs bills per line: every invocation kept (sampling would drop errors), no invocation log, LOG_LEVEL warn
			"observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false } },
			"name": "al-ummah-now-processor-stage",
			"d1_databases": [
				{
					"binding": "REPORTS_DB",
					"database_name": "al-ummah-now-reports-stage",
					"database_id": "2b2c07fc-2823-46e0-958f-acfc401544ff"
				},
				{
					"binding": "NOTIFICATIONS_DB",
					"database_name": "al-ummah-now-notifications-stage",
					"database_id": "8626a5a5-0291-4150-ac9e-6083b606a140",
					"migrations_dir": "migrations-notifications"
				},
				{
					"binding": "SEARCH_DB",
					"database_name": "al-ummah-now-search-stage",
					"database_id": "956a3550-bd20-4cfc-9bf2-b1c2265b33dd"
				}
			],
			"r2_buckets": [
				{
					"binding": "MESSAGES_BUCKET",
					"bucket_name": "al-ummah-now-messages-stage"
				},
				{
					"binding": "community_posts",
					"bucket_name": "community-posts-stage"
				},
				{
					"binding": "videos",
					"bucket_name": "videos-stage"
				},
				{
					"binding": "subtitles",
					"bucket_name": "subtitles-stage"
				},
				{
					"binding": "REVIEW_MEDIA",
					"bucket_name": "al-ummah-now-media-private-stage"
				}
			],
			"services": [{ "binding": "VIDEOS", "service": "videos-stage" }],
			"queues": {
				"producers": [{ "queue": "al-ummah-now-videos-stage", "binding": "MESSAGE_QUEUE" }, { "queue": "al-ummah-now-dlq-stage", "binding": "DLQ" }, { "queue": "al-ummah-now-review-alerts-stage", "binding": "REVIEW_ALERTS_QUEUE" }],
				"consumers": [
					{
						"queue": "al-ummah-now-videos-stage",
						"max_batch_size": 10,
						"max_batch_timeout": 30,
						"max_retries": 3,
						"dead_letter_queue": "al-ummah-now-dlq-stage"
					},
					{
						"queue": "al-ummah-now-moderation-stage",
						"max_batch_size": 5,
						"max_batch_timeout": 10,
						"max_retries": 3,
						"dead_letter_queue": "al-ummah-now-dlq-stage"
					},
					{
						// Review alerts for the Admin app (#1265): one message per batch, sent within 1 s.
						// Escalations are delayed messages to the same queue. Review runs in production only.
						"queue": "al-ummah-now-review-alerts-stage",
						"max_batch_size": 1,
						"max_batch_timeout": 1,
						"max_retries": 3,
						"dead_letter_queue": "al-ummah-now-dlq-stage"
					},
					{
						// Dead letters: logged as an alert and stored in NOTIFICATIONS_DB.dead_letters
						// (src/dlq). No dead_letter_queue of its own: a DLQ for the DLQ would loop.
						"queue": "al-ummah-now-dlq-stage",
						"max_batch_size": 10,
						"max_batch_timeout": 30,
						"max_retries": 10
					}
				]
			},
			"vars": {
				"VIDEO_REVIEW_ALLOWED": "false",
				// Error reports to the admin Errors page (docs/features/error-reporting.md)
				"ERRORS_INGEST_URL": "https://admin.api.stage.alummahnow.net/internal/errors",
				"ENVIRONMENT": "stage",
				// Archive only client analytics to R2 (apps/processor/src/types.ts MESSAGE_ARCHIVE)
				"MESSAGE_ARCHIVE": "client-analytics",
				// Logging policy (docs/operations/logging.md): warn on production, stage and QA (only warnings, errors, slow requests); debug locally
				"LOG_LEVEL": "warn",
				"WEBSOCKET_URL": "https://realtime.stage.alummahnow.net",
				"CMS_INTERNAL_URL": "https://cms.stage.alummahnow.net",
				// Owner 2026-11-13 (VR13, #1242): AI moderation is production-only; never on stage
				"AI_MODERATION_ENABLED": "false",
				"AI_MODERATION_DAILY_NEURON_CAP": "10000",
				"AI_CATEGORIZE_ENABLED": "true",
				"AI_CATEGORIZE_DAILY_NEURON_CAP": "20000",
				// Release E2E: [e2e-category:<value>] in a title is answered without a model call. Never in production.
				"CATEGORY_AI_TEST_HOOK": "true",
				// Quran Foundation Content Sync (AUN-CAPTIONS): production QF hosts in every env
				"QF_OAUTH_HOST": "https://oauth2.quran.foundation",
				"QF_API_HOST": "https://apis.quran.foundation"
			},
			"ai": { "binding": "AI" },
			"secrets_store_secrets": [
				{
					"binding": "INTERNAL_API_KEY",
					"store_id": "f8eddc9944d041919ed8dc7d08d32308",
					"secret_name": "internal-api-key-stage"
				},
				{
					// Quran Foundation Content API (AUN-CAPTIONS Content Sync): the production client in every env (owner 2026-11-13)
					"binding": "QF_CLIENT_ID",
					"store_id": "f8eddc9944d041919ed8dc7d08d32308",
					"secret_name": "quran-foundation-prod-client-id"
				},
				{
					"binding": "QF_CLIENT_SECRET",
					"store_id": "f8eddc9944d041919ed8dc7d08d32308",
					"secret_name": "quran-foundation-prod-client-secret"
				},
				// Push senders (#414, src/push/senders): a placeholder value keeps that provider log-only
				{ "binding": "APNS_KEY_P8", "store_id": "f8eddc9944d041919ed8dc7d08d32308", "secret_name": "apns-key-p8-stage" },
				{ "binding": "APNS_KEY_ID", "store_id": "f8eddc9944d041919ed8dc7d08d32308", "secret_name": "apns-key-id-stage" },
				{ "binding": "APPLE_TEAM_ID", "store_id": "f8eddc9944d041919ed8dc7d08d32308", "secret_name": "apple-team-id-stage" },
				{ "binding": "APNS_BUNDLE_IDS", "store_id": "f8eddc9944d041919ed8dc7d08d32308", "secret_name": "apns-bundle-ids-stage" },
				{ "binding": "FCM_SERVICE_ACCOUNT", "store_id": "f8eddc9944d041919ed8dc7d08d32308", "secret_name": "fcm-service-account-stage" },
				{ "binding": "FCM_PROJECT_ID", "store_id": "f8eddc9944d041919ed8dc7d08d32308", "secret_name": "fcm-project-id-stage" },
				{ "binding": "WNS_PACKAGE_SID", "store_id": "f8eddc9944d041919ed8dc7d08d32308", "secret_name": "wns-package-sid-stage" },
				{ "binding": "WNS_CLIENT_SECRET", "store_id": "f8eddc9944d041919ed8dc7d08d32308", "secret_name": "wns-client-secret-stage" }
			]
		},
		// Development environment
		"development": {
			"vars": {
				"VIDEO_REVIEW_ALLOWED": "false",
				"ENVIRONMENT": "development",
				// Logging policy (docs/operations/logging.md): warn on production, stage and QA (only warnings, errors, slow requests); debug locally
				"LOG_LEVEL": "debug"
			}
		},
		// Staging environment
		"staging": {
			"vars": {
				"VIDEO_REVIEW_ALLOWED": "false",
				"ENVIRONMENT": "staging",
				// Logging policy (docs/operations/logging.md): warn on production, stage and QA (only warnings, errors, slow requests); debug locally
				"LOG_LEVEL": "info"
			}
		}
	},

	// Observability (wrangler v3.88.0+)
	"observability": {
		"enabled": true,
		// Logging policy (docs/operations/logging.md): every invocation is sampled, so
		// every warn/error line is kept (head sampling is decided before the outcome is
		// known, so a lower rate would drop errors too). The code logs only warn/error and
		// slow requests in production; the automatic per-invocation log line is off on
		// this high-volume worker (the request/job summaries replace it).
		"head_sampling_rate": 1,
		"logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false }
	},

	// Development server configuration
	"dev": {
		"ip": "127.0.0.1",
		"port": 3088,
		"local_protocol": "http"
	}
}
