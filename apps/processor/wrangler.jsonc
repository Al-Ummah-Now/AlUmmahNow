{
	"name": "al-ummah-now-processor",
	"main": "src/index.ts",
	"compatibility_date": "2024-09-01",
	"compatibility_flags": ["nodejs_compat"],

	// D1 database for moderation
	"d1_databases": [
		{
			"binding": "REPORTS_DB",
			"database_name": "al-ummah-now-reports",
			"database_id": "YOUR_DATABASE_ID"
		}
	],

	// R2 bucket configuration
	"r2_buckets": [
		{
			"binding": "MESSAGES_BUCKET",
			"bucket_name": "al-ummah-now-messages",
			"remote": true
		},
		{
			"binding": "community_posts",
			"bucket_name": "community-posts",
			"preview_bucket_name": "community-posts-preview",
			"remote": true
		}
	],

	// Queue configuration
	"queues": {
		"consumers": [
			{
				"queue": "al-ummah-now-videos",
				"max_batch_size": 10,
				"max_batch_timeout": 30,
				"max_retries": 3,
				"dead_letter_queue": "al-ummah-now-dlq"
			}
		]
	},

	// Environment variables
	"vars": {
		"ENVIRONMENT": "production",
		"LOG_LEVEL": "info"
	},

	// Environment-specific configurations
	"env": {
		// Development environment
		"development": {
			"vars": {
				"ENVIRONMENT": "development",
				"LOG_LEVEL": "debug"
			}
		},
		// Staging environment
		"staging": {
			"vars": {
				"ENVIRONMENT": "staging",
				"LOG_LEVEL": "info"
			}
		}
	},

	// Observability (wrangler v3.88.0+)
	"observability": {
		"logs": {
			"enabled": true
		}
	},

	// Development server configuration
	"dev": {
		"ip": "127.0.0.1",
		"port": 3088,
		"local_protocol": "http"
	}
}
