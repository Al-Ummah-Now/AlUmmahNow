{
	"name": "al-ummah-now-processor",
	"main": "src/index.ts",
	"compatibility_date": "2024-09-01",
	"compatibility_flags": ["nodejs_compat"],

	// D1 database for moderation
	"d1_databases": [
		{
			"binding": "REPORTS_DB",
			"database_name": "al-ummah-now-reports",
			"database_id": "7bee932d-c6b1-47c2-ab70-7dba349104af"
		},
		{
			// Notification center + library indexes (Epic 29).
			// PLACEHOLDER: the production database does not exist yet. Before the first
			// production deploy run `npx wrangler d1 create al-ummah-now-notifications`,
			// put the returned id here and in apps/api-videos/wrangler.jsonc, then
			// `npx wrangler d1 migrations apply al-ummah-now-notifications --remote`.
			"binding": "NOTIFICATIONS_DB",
			"database_name": "al-ummah-now-notifications",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations-notifications"
		}
	],

	// Daily notification retention sweep (90 days)
	"triggers": {
		"crons": ["41 3 * * *"]
	},

	// R2 bucket configuration
	"r2_buckets": [
		{
			"binding": "MESSAGES_BUCKET",
			"bucket_name": "al-ummah-now-messages",
			"remote": true
		},
		{
			"binding": "community_posts",
			"bucket_name": "community-posts",
			"preview_bucket_name": "community-posts-preview",
			"remote": true
		}
	],

	// Queue configuration
	"queues": {
		"consumers": [
			{
				"queue": "al-ummah-now-videos",
				"max_batch_size": 10,
				"max_batch_timeout": 30,
				"max_retries": 3,
				"dead_letter_queue": "al-ummah-now-dlq"
			}
		]
	},

	// Environment variables
	"vars": {
		"ENVIRONMENT": "production",
		"LOG_LEVEL": "info",
		"WEBSOCKET_URL": "https://realtime.alummahnow.net"
	},

	// Secrets Store
	"secrets_store_secrets": [
		{
			"binding": "INTERNAL_API_KEY",
			"store_id": "f8eddc9944d041919ed8dc7d08d32308",
			"secret_name": "internal-api-key"
		}
	],

	// Environment-specific configurations
	"env": {
		// Development environment
		"development": {
			"vars": {
				"ENVIRONMENT": "development",
				"LOG_LEVEL": "debug"
			}
		},
		// Staging environment
		"staging": {
			"vars": {
				"ENVIRONMENT": "staging",
				"LOG_LEVEL": "info"
			}
		}
	},

	// Observability (wrangler v3.88.0+)
	"observability": {
		"logs": {
			"enabled": true
		}
	},

	// Development server configuration
	"dev": {
		"ip": "127.0.0.1",
		"port": 3088,
		"local_protocol": "http"
	}
}
