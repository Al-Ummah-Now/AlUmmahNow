{
  "$description": "lantern material: the depth of each surface, as CSS values over the theme's colours.",
  "radius": {
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "xl": "20px",
    "pill": "999px"
  },
  "blur": "none",
  "material": {
    "glow": "color-mix(in srgb,var(--fanous-color-primary) 34%,transparent)",
    "page": "radial-gradient(90% 60% at 50% -10%,color-mix(in srgb,var(--fanous-color-primary) 16%,transparent),transparent 70%),linear-gradient(180deg,var(--fanous-color-hero-end),var(--fanous-color-background))",
    "header": "linear-gradient(180deg,color-mix(in srgb,var(--fanous-c-nav-bg) 88%,var(--fanous-color-primary)),var(--fanous-c-nav-bg))",
    "headerEdge": "0 1px 0 color-mix(in srgb,var(--fanous-color-primary) 34%,transparent),0 10px 30px -18px var(--m-glow)",
    "rail": "linear-gradient(180deg,var(--fanous-color-surface),var(--fanous-color-background))",
    "railEdge": "inset -1px 0 0 color-mix(in srgb,var(--fanous-color-primary) 16%,transparent)",
    "card": "radial-gradient(120% 90% at 50% 0%,color-mix(in srgb,var(--fanous-color-primary) 7%,transparent),transparent 62%),linear-gradient(180deg,var(--fanous-color-surface-raised),var(--fanous-color-surface))",
    "border": "linear-gradient(180deg,color-mix(in srgb,var(--fanous-color-primary) 46%,transparent),color-mix(in srgb,var(--fanous-color-divider) 70%,transparent) 55%)",
    "cardEdge": "inset 0 1px 0 color-mix(in srgb,var(--fanous-color-primary-sheen) 14%,transparent),0 14px 34px -22px rgb(9 21 30/.5)",
    "raised": "linear-gradient(180deg,var(--fanous-color-surface-raised),var(--fanous-color-surface))",
    "raisedEdge": "0 0 0 1px color-mix(in srgb,var(--fanous-color-primary) 26%,transparent),0 24px 48px -20px rgb(9 21 30/.55)",
    "control": "var(--fanous-color-background)",
    "controlEdge": "inset 0 1px 2px rgb(9 21 30/.14)",
    "primary": "linear-gradient(180deg,var(--fanous-color-primary-hover),var(--fanous-color-primary) 52%,var(--fanous-color-primary-pressed))",
    "primaryHover": "linear-gradient(180deg,var(--fanous-color-primary-sheen),var(--fanous-color-primary-hover) 60%,var(--fanous-color-primary))",
    "primaryPress": "var(--fanous-color-primary-pressed)",
    "primaryEdge": "inset 0 1px 0 color-mix(in srgb,var(--fanous-color-primary-sheen) 80%,transparent),0 6px 18px -8px var(--m-glow)",
    "active": "linear-gradient(var(--to-end),color-mix(in srgb,var(--fanous-color-primary) 26%,transparent),transparent 92%)",
    "activeEdge": "none",
    "hover": "color-mix(in srgb,var(--fanous-color-primary) 12%,transparent)",
    "hero": "radial-gradient(70% 120% at 18% 0%,color-mix(in srgb,var(--fanous-color-primary) 26%,transparent),transparent 65%),linear-gradient(135deg,var(--fanous-color-surface-raised),var(--fanous-color-hero-start))",
    "thumbEdge": "0 0 0 1px color-mix(in srgb,var(--fanous-color-primary) 30%,transparent),0 0 26px -6px var(--m-glow)",
    "sel": "color-mix(in srgb,var(--fanous-color-primary) 13%,transparent)",
    "selEdge": "none",
    "selBar": "var(--fanous-c-nav-indicator)",
    "selGlow": "0 0 8px color-mix(in srgb,var(--fanous-color-primary) 42%,transparent)",
    "player": "0 0 0 1px color-mix(in srgb,var(--fanous-color-primary) 34%,transparent),0 0 34px -10px var(--m-glow)",
    "playerInner": "none",
    "playerRing": "inset 0 0 0 1px color-mix(in srgb,var(--fanous-color-primary) 46%,transparent)"
  }
}
