        "$value": "{font.pair.system.latin}"
      },
      "arabic": {
        "$value": "{font.pair.system.arabic}"
      }
    }
  },
  "typography": {
    "$type": "typography",
    "latin": {
      "display": {
        "$value": {
          "fontFamily": "{font.family.latin}",
          "fontSize": "34px",
          "fontWeight": 700,
          "lineHeight": 1.2,
          "letterSpacing": "-0.4px"
        }
      },
      "headline": {
        "$value": {
          "fontFamily": "{font.family.latin}",
