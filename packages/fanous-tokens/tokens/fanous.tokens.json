    "safeAreaHorizontal": {
      "$value": "96px"
    },
    "safeAreaVertical": {
      "$value": "54px"
    },
    "railGap": {
      "$value": "24px"
    }
  },
  "layout": {
    "$type": "dimension",
    "targetMin": {
      "$value": "44px",
      "$description": "Minimum touch target"
    }
  }
