  "font": {
    "$type": "fontFamily",
    "pair": {
      "$description": "Options a theme can choose by name. All are open-licensed (SIL OFL 1.1) except `system`, which ships no font.",
      "system": {
        "latin": {
          "$value": [
            "system-ui",
            "sans-serif"
          ]
        },
        "arabic": {
          "$value": [
            "system-ui",
            "sans-serif"
          ]
        }
      },
      "plexSans": {
        "latin": {
          "$value": [
            "IBM Plex Sans",
            "system-ui",
            "sans-serif"
          ]
        },
        "arabic": {
          "$value": [
            "IBM Plex Sans Arabic",
            "system-ui",
            "sans-serif"
          ]
        }
      },
      "notoKufiInter": {
        "latin": {
          "$value": [
            "Inter",
            "system-ui",
            "sans-serif"
          ]
