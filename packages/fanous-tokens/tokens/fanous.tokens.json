  "numerals": {
    "$description": "Unicode number-system ids (CLDR). Apps offer western digits or Eastern Arabic digits.",
    "$type": "string",
    "western": {
      "$value": "latn"
    },
    "easternArabic": {
      "$value": "arab"
    }
  },
  "spacing": {
    "$type": "dimension",
    "none": {
      "$value": "0px"
    },
    "xxs": {
      "$value": "2px"
    },
    "xs": {
      "$value": "4px"
    },
    "sm": {
      "$value": "8px"
    },
    "md": {
      "$value": "12px"
    },
    "lg": {
      "$value": "16px"
    },
    "xl": {
      "$value": "24px"
    },
    "xxl": {
      "$value": "32px"
    },
    "xxxl": {
      "$value": "48px"
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": {
        "$value": "0ms",
        "$description": "Replaces every duration under reduced motion"
      },
      "fast": {
        "$value": "120ms"
      },
      "standard": {
        "$value": "200ms"
      },
      "slow": {
        "$value": "320ms"
      },
      "glowPulse": {
        "$value": "1600ms",
        "$description": "One cycle of the lantern-glow loader and focus motif"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      },
      "enter": {
        "$value": [
          0,
          0,
          0,
          1
        ]
      },
      "exit": {
        "$value": [
          0.3,
          0,
          1,
          1
        ]
      },
      "glow": {
        "$value": [
          0.45,
          0,
          0.55,
          1
        ]
      }
    }
  },
  "focus": {
    "$type": "dimension",
    "ringWidth": {
      "$value": "2px"
    },
    "ringOffset": {
      "$value": "2px"
    },
    "tvRingWidth": {
      "$value": "4px"
    },
    "tvGlowRadius": {
      "$value": "24px"
