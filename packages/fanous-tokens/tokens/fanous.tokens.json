{
  "$description": "Fanous design tokens (W3C design tokens format). The single source of truth: edit this file, then run `pnpm tokens:generate`.",
  "color": {
    "$type": "color",
    "brand": {
      "$description": "Primitives from docs/native-apps/EPICS.md section 3. Do not change without an owner decision.",
      "night": { "$value": "#093041", "$description": "App background (dark, default theme)" },
      "nightDeep": { "$value": "#07425a", "$description": "Hero gradient start, TV backgrounds" },
      "nightShallow": { "$value": "#083f58", "$description": "Hero gradient end, TV backgrounds" },
      "lantern": { "$value": "#ffa037", "$description": "Primary actions, progress, focus" },
      "glow": { "$value": "#ffc46b", "$description": "Highlights, live badges, TV focus glow" },
      "earth": { "$value": "#8e6c53", "$description": "Secondary actions" },
      "parchment": { "$value": "#f7f1e8", "$description": "Light theme background" },
      "verified": { "$value": "#16a34a", "$description": "Scholar verification, success" },
      "error": { "$value": "#b00020", "$description": "Errors" }
    },
    "derived": {
      "$description": "Steps derived from the brand colours so semantic pairs meet WCAG 2.1 AA.",
      "white": { "$value": "#ffffff" },
      "ink": { "$value": "#1c1a17", "$description": "Primary text on parchment" },
      "inkSecondary": { "$value": "#4a433b" },
      "inkMuted": { "$value": "#5f574d" },
      "mist": { "$value": "#c9d6dc", "$description": "Secondary text on night" },
      "mistMuted": { "$value": "#a8bac3" },
      "nightRaised": { "$value": "#0e3a4e", "$description": "Card surface on night" },
      "nightHigh": { "$value": "#134a62", "$description": "Sheet and dialog surface on night" },
      "outlineDark": { "$value": "#7f9aa7" },
      "dividerDark": { "$value": "#1d5068" },
      "parchmentRaised": { "$value": "#fffbf4", "$description": "Card surface on parchment" },
      "parchmentHigh": { "$value": "#ffffff" },
      "parchmentDeep": { "$value": "#efe6d6", "$description": "Light hero gradient start" },
      "outlineLight": { "$value": "#8c7f70" },
      "dividerLight": { "$value": "#ddd2c1" },
      "lanternDeep": { "$value": "#a85600", "$description": "Lantern for focus and progress on parchment" },
      "lanternInk": { "$value": "#9a4f00", "$description": "Lantern for links on parchment" },
      "verifiedBright": { "$value": "#4ade80", "$description": "Verified as text on night" },
      "verifiedDeep": { "$value": "#166534", "$description": "Verified as text and fill on parchment" },
      "errorBright": { "$value": "#ff9c94", "$description": "Error as text on night" },
      "goldFlame": { "$value": "#f8e8be", "$description": "Sampled from logo.png: flame core. Glow and sheen highlights" },
      "goldLight": { "$value": "#f5cf92", "$description": "Sampled from logo.png: lit filigree. Primary hover" },
      "gold": { "$value": "#e8b477", "$description": "Sampled from logo.png: dominant lantern gold. Primary action" },
      "goldPressed": { "$value": "#cf985d", "$description": "Sampled from logo.png: shaded filigree. Primary pressed" },
      "goldEdge": { "$value": "#93612a", "$description": "Sampled from logo.png: burnished metal. Button edge and focus on parchment" },
      "inkNight": { "$value": "#09151e", "$description": "Sampled from logo.png: deepest sky. Text on gold" },
      "tealGlass": { "$value": "#1696b0", "$description": "Sampled from logo.png: lit teal panel" },
      "tealMist": { "$value": "#81c2c2", "$description": "Sampled from logo.png: sky haze" },
      "tealDeep": { "$value": "#2a6975", "$description": "Sampled from logo.png: shaded teal panel" }
    },
    "theme": {
      "dark": {
        "background": { "$value": "{color.brand.night}", "$extensions": { "fanous": { "role": "surface" } } },
        "surface": { "$value": "{color.derived.nightRaised}", "$extensions": { "fanous": { "role": "surface" } } },
        "surfaceRaised": { "$value": "{color.derived.nightHigh}", "$extensions": { "fanous": { "role": "surface" } } },
        "heroStart": { "$value": "{color.brand.nightDeep}", "$extensions": { "fanous": { "role": "surface" } } },
        "heroEnd": { "$value": "{color.brand.nightShallow}", "$extensions": { "fanous": { "role": "surface" } } },
        "textPrimary": { "$value": "{color.brand.parchment}", "$extensions": { "fanous": { "role": "text" } } },
        "textSecondary": { "$value": "{color.derived.mist}", "$extensions": { "fanous": { "role": "text" } } },
        "textMuted": { "$value": "{color.derived.mistMuted}", "$extensions": { "fanous": { "role": "text" } } },
        "link": { "$value": "{color.brand.glow}", "$extensions": { "fanous": { "role": "text" } } },
        "successText": { "$value": "{color.derived.verifiedBright}", "$extensions": { "fanous": { "role": "text" } } },
        "errorText": { "$value": "{color.derived.errorBright}", "$extensions": { "fanous": { "role": "text" } } },
        "primary": { "$value": "{color.derived.gold}", "$description": "Golden primary action", "$extensions": { "fanous": { "role": "fill" } } },
        "onPrimary": { "$value": "{color.derived.inkNight}", "$extensions": { "fanous": { "role": "on", "on": "primary" } } },
        "primaryHover": { "$value": "{color.derived.goldLight}", "$extensions": { "fanous": { "role": "fill" } } },
        "onPrimaryHover": { "$value": "{color.derived.inkNight}", "$extensions": { "fanous": { "role": "on", "on": "primaryHover" } } },
        "primaryPressed": { "$value": "{color.derived.goldPressed}", "$extensions": { "fanous": { "role": "fill" } } },
        "onPrimaryPressed": { "$value": "{color.derived.inkNight}", "$extensions": { "fanous": { "role": "on", "on": "primaryPressed" } } },
        "primaryDisabled": { "$value": "{color.derived.nightHigh}", "$extensions": { "fanous": { "role": "fill" } } },
        "onPrimaryDisabled": { "$value": "{color.derived.mistMuted}", "$extensions": { "fanous": { "role": "on", "on": "primaryDisabled" } } },
        "primaryEdge": { "$value": "{color.derived.goldLight}", "$description": "Hairline that holds the gold fill against the page", "$extensions": { "fanous": { "role": "nontext" } } },
        "primarySheen": { "$value": "{color.derived.goldFlame}", "$description": "Highlight stop of the gold sheen. Never behind text alone", "$extensions": { "fanous": { "role": "decorative" } } },
        "motif": { "$value": "{color.derived.tealDeep}", "$description": "Geometric pattern and lantern-light graphics", "$extensions": { "fanous": { "role": "decorative" } } },
        "secondary": { "$value": "{color.brand.earth}", "$extensions": { "fanous": { "role": "fill" } } },
        "onSecondary": { "$value": "{color.derived.white}", "$extensions": { "fanous": { "role": "on", "on": "secondary" } } },
        "verifiedFill": { "$value": "{color.derived.verifiedDeep}", "$extensions": { "fanous": { "role": "fill" } } },
        "onVerifiedFill": { "$value": "{color.derived.white}", "$extensions": { "fanous": { "role": "on", "on": "verifiedFill" } } },
        "errorFill": { "$value": "{color.brand.error}", "$extensions": { "fanous": { "role": "fill" } } },
        "onErrorFill": { "$value": "{color.derived.white}", "$extensions": { "fanous": { "role": "on", "on": "errorFill" } } },
        "live": { "$value": "{color.brand.glow}", "$extensions": { "fanous": { "role": "fill" } } },
        "onLive": { "$value": "{color.brand.night}", "$extensions": { "fanous": { "role": "on", "on": "live" } } },
        "accent": { "$value": "{color.brand.lantern}", "$description": "Progress bars and selected indicators", "$extensions": { "fanous": { "role": "nontext" } } },
        "focusRing": { "$value": "{color.derived.goldLight}", "$extensions": { "fanous": { "role": "nontext" } } },
        "focusGlow": { "$value": "{color.brand.glow}", "$description": "10-foot focus glow", "$extensions": { "fanous": { "role": "nontext" } } },
        "verifiedIcon": { "$value": "{color.derived.verifiedBright}", "$extensions": { "fanous": { "role": "nontext" } } },
        "outline": { "$value": "{color.derived.outlineDark}", "$description": "Input and control outlines", "$extensions": { "fanous": { "role": "nontext" } } },
        "divider": { "$value": "{color.derived.dividerDark}", "$description": "Decorative separators only", "$extensions": { "fanous": { "role": "decorative" } } }
      },
      "light": {
        "background": { "$value": "{color.brand.parchment}", "$extensions": { "fanous": { "role": "surface" } } },
        "surface": { "$value": "{color.derived.parchmentRaised}", "$extensions": { "fanous": { "role": "surface" } } },
        "surfaceRaised": { "$value": "{color.derived.parchmentHigh}", "$extensions": { "fanous": { "role": "surface" } } },
        "heroStart": { "$value": "{color.derived.parchmentDeep}", "$extensions": { "fanous": { "role": "surface" } } },
        "heroEnd": { "$value": "{color.brand.parchment}", "$extensions": { "fanous": { "role": "surface" } } },
        "textPrimary": { "$value": "{color.derived.ink}", "$extensions": { "fanous": { "role": "text" } } },
        "textSecondary": { "$value": "{color.derived.inkSecondary}", "$extensions": { "fanous": { "role": "text" } } },
        "textMuted": { "$value": "{color.derived.inkMuted}", "$extensions": { "fanous": { "role": "text" } } },
        "link": { "$value": "{color.derived.lanternInk}", "$extensions": { "fanous": { "role": "text" } } },
        "successText": { "$value": "{color.derived.verifiedDeep}", "$extensions": { "fanous": { "role": "text" } } },
        "errorText": { "$value": "{color.brand.error}", "$extensions": { "fanous": { "role": "text" } } },
        "primary": { "$value": "{color.derived.gold}", "$description": "Golden primary action", "$extensions": { "fanous": { "role": "fill" } } },
        "onPrimary": { "$value": "{color.derived.inkNight}", "$extensions": { "fanous": { "role": "on", "on": "primary" } } },
        "primaryHover": { "$value": "{color.derived.goldLight}", "$extensions": { "fanous": { "role": "fill" } } },
        "onPrimaryHover": { "$value": "{color.derived.inkNight}", "$extensions": { "fanous": { "role": "on", "on": "primaryHover" } } },
        "primaryPressed": { "$value": "{color.derived.goldPressed}", "$extensions": { "fanous": { "role": "fill" } } },
        "onPrimaryPressed": { "$value": "{color.derived.inkNight}", "$extensions": { "fanous": { "role": "on", "on": "primaryPressed" } } },
        "primaryDisabled": { "$value": "{color.derived.parchmentDeep}", "$extensions": { "fanous": { "role": "fill" } } },
        "onPrimaryDisabled": { "$value": "{color.derived.inkMuted}", "$extensions": { "fanous": { "role": "on", "on": "primaryDisabled" } } },
        "primaryEdge": { "$value": "{color.derived.goldEdge}", "$description": "Hairline that holds the gold fill against the page", "$extensions": { "fanous": { "role": "nontext" } } },
        "primarySheen": { "$value": "{color.derived.goldFlame}", "$description": "Highlight stop of the gold sheen. Never behind text alone", "$extensions": { "fanous": { "role": "decorative" } } },
        "motif": { "$value": "{color.derived.goldPressed}", "$description": "Geometric pattern and lantern-light graphics", "$extensions": { "fanous": { "role": "decorative" } } },
        "secondary": { "$value": "{color.brand.earth}", "$extensions": { "fanous": { "role": "fill" } } },
        "onSecondary": { "$value": "{color.derived.white}", "$extensions": { "fanous": { "role": "on", "on": "secondary" } } },
        "verifiedFill": { "$value": "{color.derived.verifiedDeep}", "$extensions": { "fanous": { "role": "fill" } } },
        "onVerifiedFill": { "$value": "{color.derived.white}", "$extensions": { "fanous": { "role": "on", "on": "verifiedFill" } } },
        "errorFill": { "$value": "{color.brand.error}", "$extensions": { "fanous": { "role": "fill" } } },
        "onErrorFill": { "$value": "{color.derived.white}", "$extensions": { "fanous": { "role": "on", "on": "errorFill" } } },
        "live": { "$value": "{color.brand.glow}", "$extensions": { "fanous": { "role": "fill" } } },
        "onLive": { "$value": "{color.brand.night}", "$extensions": { "fanous": { "role": "on", "on": "live" } } },
        "accent": { "$value": "{color.derived.lanternDeep}", "$description": "Progress bars and selected indicators", "$extensions": { "fanous": { "role": "nontext" } } },
        "focusRing": { "$value": "{color.derived.goldEdge}", "$extensions": { "fanous": { "role": "nontext" } } },
        "focusGlow": { "$value": "{color.derived.lanternDeep}", "$description": "10-foot focus glow", "$extensions": { "fanous": { "role": "nontext" } } },
        "verifiedIcon": { "$value": "{color.derived.verifiedDeep}", "$extensions": { "fanous": { "role": "nontext" } } },
        "outline": { "$value": "{color.derived.outlineLight}", "$description": "Input and control outlines", "$extensions": { "fanous": { "role": "nontext" } } },
        "divider": { "$value": "{color.derived.dividerLight}", "$description": "Decorative separators only", "$extensions": { "fanous": { "role": "decorative" } } }
      }
    }
  },
  "font": {
    "$type": "fontFamily",
    "pair": {
      "$description": "Options for decision D6. All are open-licensed (SIL OFL 1.1) except `system`, which ships no font.",
      "system": {
        "latin": { "$value": ["system-ui", "sans-serif"] },
        "arabic": { "$value": ["system-ui", "sans-serif"] }
      },
      "plexSans": {
        "latin": { "$value": ["IBM Plex Sans", "system-ui", "sans-serif"] },
        "arabic": { "$value": ["IBM Plex Sans Arabic", "system-ui", "sans-serif"] }
      },
      "notoKufiInter": {
        "latin": { "$value": ["Inter", "system-ui", "sans-serif"] },
        "arabic": { "$value": ["Noto Kufi Arabic", "system-ui", "sans-serif"] }
      }
    },
    "family": {
      "$description": "The active pair. Stays on `system` until the owner decides D6.",
      "latin": { "$value": "{font.pair.system.latin}" },
      "arabic": { "$value": "{font.pair.system.arabic}" }
    }
  },
  "typography": {
    "$type": "typography",
    "latin": {
      "display": { "$value": { "fontFamily": "{font.family.latin}", "fontSize": "34px", "fontWeight": 700, "lineHeight": 1.2, "letterSpacing": "-0.4px" } },
      "headline": { "$value": { "fontFamily": "{font.family.latin}", "fontSize": "24px", "fontWeight": 700, "lineHeight": 1.25, "letterSpacing": "-0.2px" } },
      "title": { "$value": { "fontFamily": "{font.family.latin}", "fontSize": "20px", "fontWeight": 600, "lineHeight": 1.3, "letterSpacing": "0px" } },
      "body": { "$value": { "fontFamily": "{font.family.latin}", "fontSize": "16px", "fontWeight": 400, "lineHeight": 1.5, "letterSpacing": "0px" } },
      "label": { "$value": { "fontFamily": "{font.family.latin}", "fontSize": "14px", "fontWeight": 500, "lineHeight": 1.4, "letterSpacing": "0.1px" } },
      "caption": { "$value": { "fontFamily": "{font.family.latin}", "fontSize": "12px", "fontWeight": 400, "lineHeight": 1.4, "letterSpacing": "0.2px" } },
      "tvHero": { "$value": { "fontFamily": "{font.family.latin}", "fontSize": "48px", "fontWeight": 700, "lineHeight": 1.15, "letterSpacing": "-0.5px" } },
      "tvBody": { "$value": { "fontFamily": "{font.family.latin}", "fontSize": "24px", "fontWeight": 400, "lineHeight": 1.4, "letterSpacing": "0px" } }
    },
    "arabic": {
      "$description": "Arabic runs one step larger with taller lines and never takes letter-spacing, which breaks joined letterforms.",
      "display": { "$value": { "fontFamily": "{font.family.arabic}", "fontSize": "36px", "fontWeight": 700, "lineHeight": 1.45, "letterSpacing": "0px" } },
      "headline": { "$value": { "fontFamily": "{font.family.arabic}", "fontSize": "26px", "fontWeight": 700, "lineHeight": 1.5, "letterSpacing": "0px" } },
      "title": { "$value": { "fontFamily": "{font.family.arabic}", "fontSize": "22px", "fontWeight": 600, "lineHeight": 1.5, "letterSpacing": "0px" } },
      "body": { "$value": { "fontFamily": "{font.family.arabic}", "fontSize": "17px", "fontWeight": 400, "lineHeight": 1.7, "letterSpacing": "0px" } },
      "label": { "$value": { "fontFamily": "{font.family.arabic}", "fontSize": "15px", "fontWeight": 500, "lineHeight": 1.6, "letterSpacing": "0px" } },
      "caption": { "$value": { "fontFamily": "{font.family.arabic}", "fontSize": "13px", "fontWeight": 400, "lineHeight": 1.6, "letterSpacing": "0px" } },
      "tvHero": { "$value": { "fontFamily": "{font.family.arabic}", "fontSize": "50px", "fontWeight": 700, "lineHeight": 1.4, "letterSpacing": "0px" } },
      "tvBody": { "$value": { "fontFamily": "{font.family.arabic}", "fontSize": "26px", "fontWeight": 400, "lineHeight": 1.6, "letterSpacing": "0px" } }
    }
  },
  "numerals": {
    "$description": "Unicode number-system ids (CLDR). Apps offer western digits or Eastern Arabic digits.",
    "$type": "string",
    "western": { "$value": "latn" },
    "easternArabic": { "$value": "arab" }
  },
  "spacing": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "xxs": { "$value": "2px" },
    "xs": { "$value": "4px" },
    "sm": { "$value": "8px" },
    "md": { "$value": "12px" },
    "lg": { "$value": "16px" },
    "xl": { "$value": "24px" },
    "xxl": { "$value": "32px" },
    "xxxl": { "$value": "48px" }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "12px" },
    "xl": { "$value": "20px" },
    "full": { "$value": "999px" }
  },
  "elevation": {
    "$type": "shadow",
    "low": { "$value": { "color": "#00000033", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px" } },
    "medium": { "$value": { "color": "#00000040", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "0px" } },
    "high": { "$value": { "color": "#00000059", "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "0px" } }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": "0ms", "$description": "Replaces every duration under reduced motion" },
      "fast": { "$value": "120ms" },
      "standard": { "$value": "200ms" },
      "slow": { "$value": "320ms" },
      "glowPulse": { "$value": "1600ms", "$description": "One cycle of the lantern-glow loader and focus motif" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "enter": { "$value": [0, 0, 0, 1] },
      "exit": { "$value": [0.3, 0, 1, 1] },
      "glow": { "$value": [0.45, 0, 0.55, 1] }
    }
  },
  "focus": {
    "$type": "dimension",
    "ringWidth": { "$value": "2px" },
    "ringOffset": { "$value": "2px" },
    "tvRingWidth": { "$value": "4px" },
    "tvGlowRadius": { "$value": "24px" }
  },
  "tv": {
    "$description": "10-foot variant. Values are in dp at a 1920x1080 layout.",
    "$type": "dimension",
    "targetMin": { "$value": "48px" },
    "safeAreaHorizontal": { "$value": "96px" },
    "safeAreaVertical": { "$value": "54px" },
    "railGap": { "$value": "24px" }
  },
  "layout": {
    "$type": "dimension",
    "targetMin": { "$value": "44px", "$description": "Minimum touch target" }
  }
}
