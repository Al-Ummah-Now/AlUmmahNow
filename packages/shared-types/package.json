{
  "name": "@al-ummah/shared-types",
  "version": "1.0.0",
  "description": "Shared TypeScript types for Al Ummah Now",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "uuid": "^13.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
