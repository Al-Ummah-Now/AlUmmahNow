{
  "name": "@al-ummah/shared-types",
  "version": "1.0.0",
  "description": "Shared TypeScript types for Al Ummah Now",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./error-trail": {
      "types": "./dist/error-reporting/trail.d.ts",
      "default": "./dist/error-reporting/trail.js"
    },
    "./release-check": {
      "types": "./dist/release-check.d.ts",
      "default": "./dist/release-check.js"
    },
    "./page-blocks.css": "./src/page-blocks.css"
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "type-check": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
