{
  "name": "al-ummah-now",
  "version": "1.0.0",
  "private": true,
  "description": "Al Ummah Now - Islamic content platform monorepo",
  "pnpm": {
    "overrides": {
      "glob": ">=11.1.0",
      "esbuild": ">=0.25.0",
      "body-parser": ">=2.2.1",
      "next": ">=16.2.10",
      "qs": ">=6.14.1",
      "fast-xml-parser": ">=5.9.3",
      "handlebars": ">=4.7.9",
      "@types/react-big-calendar>@types/react": "18.2.19"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:scripts": "node --experimental-strip-types --no-warnings --test scripts/release/__tests__/*.test.ts scripts/qa/__tests__/*.test.ts scripts/migrations/__tests__/*.test.ts",
    "migrate:legacy-channel": "tsx scripts/migrations/assign-legacy-channel.ts",
    "qa:cleanup": "tsx scripts/qa/cleanup-e2e-leftovers.ts",
    "tokens:generate": "node --experimental-strip-types --no-warnings packages/fanous-tokens/src/cli.ts && node --experimental-strip-types --no-warnings packages/fanous-tokens/src/player.ts",
    "check:tokens": "node --experimental-strip-types --no-warnings packages/fanous-tokens/src/cli.ts --check && node --experimental-strip-types --no-warnings packages/fanous-tokens/src/player.ts --check",
    "themes:build": "node --experimental-strip-types --no-warnings packages/theme-packages/scripts/build-themes.ts",
    "themes:check": "node --experimental-strip-types --no-warnings packages/theme-packages/scripts/build-themes.ts --check",
    "test:themes": "node --experimental-strip-types --no-warnings --test packages/theme-packages/test/*.test.ts",
    "check:theme-colors": "node --experimental-strip-types --no-warnings packages/fanous-tokens/src/color-lint-cli.ts",
    "test:tokens": "node --experimental-strip-types --no-warnings --test packages/fanous-tokens/test/*.test.ts",
    "check:config": "node --experimental-strip-types --no-warnings scripts/release/check-wrangler-config.ts",
    "check:site-theme": "node --experimental-strip-types --no-warnings scripts/release/check-site-theme.ts",
    "check:migrations": "node --experimental-strip-types --no-warnings scripts/release/migration-guard.ts",
    "schema:snapshot": "node --experimental-strip-types --no-warnings scripts/release/schema-snapshot.ts --write",
    "check:schema": "node --experimental-strip-types --no-warnings scripts/release/schema-snapshot.ts --check",
    "smoke": "node --experimental-strip-types --no-warnings scripts/release/smoke.ts",
    "release:migrate": "node --experimental-strip-types --no-warnings scripts/release/d1-migrate.ts",
    "release:promote": "node --experimental-strip-types --no-warnings scripts/release/promote.ts",
    "release:rollback": "node --experimental-strip-types --no-warnings scripts/release/rollback.ts",
    "release:tag": "node --experimental-strip-types --no-warnings scripts/release/release-tag.ts",
    "check:post-counters": "node --experimental-strip-types --no-warnings scripts/release/check-post-counters.ts",
    "check:rollup-import": "node --experimental-strip-types --no-warnings scripts/release/check-rollup-import.ts",
    "check:subscription-import": "node --experimental-strip-types --no-warnings scripts/release/check-subscription-import.ts",
    "check:secrets": "node --experimental-strip-types --no-warnings scripts/release/check-secrets.ts",
    "clean": "turbo run clean && rm -rf node_modules",
    "log-service:dev": "turbo run dev --filter=@al-ummah/log-service",
    "log-service:start": "turbo run start --filter=@al-ummah/log-service",
    "logs:monitor": "tsx monitor-logs.ts",
    "logs:monitor:web": "tsx monitor-logs.ts web",
    "logs:monitor:api": "tsx monitor-logs.ts api-videos",
    "logs:monitor:errors": "tsx monitor-logs.ts --level=error",
    "web:dev": "turbo run dev --filter=@al-ummah/web",
    "web:build": "turbo run build --filter=@al-ummah/web",
    "web:deploy:qa": "turbo run deploy:qa --filter=@al-ummah/web",
    "web:deploy:production": "turbo run deploy:production --filter=@al-ummah/web",
    "api:dev": "turbo run dev --filter=@al-ummah/api-videos",
    "api:build": "turbo run build --filter=@al-ummah/api-videos",
    "api:deploy": "turbo run deploy --filter=@al-ummah/api-videos",
    "api:deploy:qa": "turbo run deploy:qa --filter=@al-ummah/api-videos",
    "processor:dev": "turbo run dev --filter=@al-ummah/processor",
    "processor:build": "turbo run build --filter=@al-ummah/processor",
    "processor:deploy": "turbo run deploy --filter=@al-ummah/processor",
    "processor:deploy:qa": "turbo run deploy:qa --filter=@al-ummah/processor",
    "websocket:dev": "turbo run dev --filter=@al-ummah/websocket-server",
    "websocket:build": "turbo run build --filter=@al-ummah/websocket-server",
    "websocket:deploy": "turbo run deploy --filter=@al-ummah/websocket-server",
    "websocket:deploy:qa": "turbo run deploy:qa --filter=@al-ummah/websocket-server",
    "admin:dev": "turbo run dev --filter=@al-ummah/admin-api",
    "admin:build": "turbo run build --filter=@al-ummah/admin-api",
    "admin:deploy": "turbo run deploy --filter=@al-ummah/admin-api",
    "admin:deploy:qa": "turbo run deploy:qa --filter=@al-ummah/admin-api",
    "admin-web:dev": "turbo run dev --filter=@al-ummah/admin-web",
    "admin-web:build": "turbo run build --filter=@al-ummah/admin-web",
    "admin-web:deploy:qa": "turbo run deploy:qa --filter=@al-ummah/admin-web",
    "admin-web:deploy:production": "turbo run deploy:production --filter=@al-ummah/admin-web",
    "deploy:all": "pnpm run web:deploy:production && pnpm run api:deploy && pnpm run processor:deploy && pnpm run websocket:deploy && pnpm run admin:deploy",
    "deploy:qa": "pnpm run web:deploy:qa && pnpm run api:deploy:qa && pnpm run processor:deploy:qa && pnpm run websocket:deploy:qa && pnpm run admin:deploy:qa && pnpm run admin-web:deploy:qa",
    "check:committed-secrets": "node scripts/check-committed-secrets.mjs"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "turbo": "^2.6.0",
    "typescript": "5.9.3",
    "wrangler": "^4.108.0"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
}
